<h2 class="auth-card__title">Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="auth-form__group">
    <%= f.label :password, "New password", class: "auth-form__label" %>
    <% if @minimum_password_length %>
      <p class="auth-form__hint">(<%= @minimum_password_length %> characters minimum)</p>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "auth-form__input" %>
  </div>

  <div class="auth-form__group">
    <%= f.label :password_confirmation, "Confirm new password", class: "auth-form__label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-form__input" %>
  </div>

  <div class="auth-form__actions">
    <%= f.submit "Change my password", class: "auth-form__submit" %>
  </div>
<% end %>

<div class="auth-card__links">
  <%= render "devise/shared/links" %>
</div>
