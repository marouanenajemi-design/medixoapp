<div class="page-shell" data-controller="chatbot">

  <%# ── Header ── %>
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("chatbot.title") %></h1>
      <div class="page-subtitle"><%= t("chatbot.subtitle") %></div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <%= button_to t("chatbot.actions.new_chat"), chatbot_new_path, method: :post,
            class: "btn btn-sm btn-outline-secondary",
            form: { data: { turbo_confirm: t("chatbot.actions.new_chat_confirm") } } %>
      <% if @messages.any? %>
        <%= button_to t("chatbot.actions.clear"), chatbot_clear_path, method: :delete,
              class: "btn btn-sm btn-outline-danger",
              form: { data: { turbo_confirm: t("chatbot.actions.clear_confirm") } } %>
      <% end %>
    </div>
  </div>

  <%# ── Disclaimer ── %>
  <div class="content-card mb-4">
    <div class="alert alert-warning rounded-4 mb-0" role="alert">
      <strong><%= t("chatbot.disclaimer_title") %></strong>
      <div class="mt-1"><%= t("chatbot.disclaimer_body") %></div>
    </div>
  </div>

  <%# ── Chat card ── %>
  <div class="content-card p-0 overflow-hidden">

    <%# ── Message thread ── %>
    <div class="chat-thread" id="chat-thread" data-chatbot-target="thread">

      <% if @messages.empty? %>
        <div class="chat-empty">
          <i class="bi bi-stars d-block mb-2"></i>
          <p class="mb-1 fw-semibold"><%= t("chatbot.empty.title") %></p>
          <p class="text-muted small mb-0"><%= t("chatbot.empty.hint") %></p>
        </div>
      <% else %>
        <% @messages.each do |message| %>
          <%= render partial: "chatbot/message", locals: { message: message } %>
        <% end %>
      <% end %>

      <%# "Thinking…" indicator — hidden by default, shown by Stimulus on submit -%>
      <div class="chat-thinking" data-chatbot-target="thinking" hidden>
        <div class="chat-avatar" aria-hidden="true"><i class="bi bi-stars"></i></div>
        <span class="text-muted small"><%= t("chatbot.thinking") %></span>
        <div class="chat-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </div>

    </div>

    <%# ── Input area ── %>
    <div class="chat-input-area">
      <%= form_with url: chatbot_ask_path, method: :post,
            data: {
              "action" => "turbo:submit-start->chatbot#showLoading turbo:submit-end->chatbot#hideLoading"
            } do |f| %>

        <%= f.text_field :query,
              class: "form-control chat-input-field",
              placeholder: t("chatbot.form.placeholder"),
              autocomplete: "off",
              "data-chatbot-target" => "input",
              required: true %>

        <button type="submit" class="btn btn-primary chat-send-btn" aria-label="<%= t("chatbot.form.submit") %>">
          <span data-chatbot-target="submit"><i class="bi bi-send-fill"></i></span>
          <span data-chatbot-target="spinner" hidden>
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
          </span>
        </button>

      <% end %>
    </div>

  </div>

</div>
