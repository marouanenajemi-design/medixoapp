<div class="cxp" data-controller="chatbot" data-error-message="<%= t("chatbot.messages.service_unavailable") %>">

  <%# ── Header ─────────────────────────────────────────────────────────────── %>
  <div class="cxp-header">
    <div class="cxp-header-brand">
      <div class="cxp-avatar cxp-avatar--lg"><i class="bi bi-stars"></i></div>
      <div>
        <h1 class="cxp-title"><%= t("chatbot.title") %></h1>
        <p class="cxp-subtitle mb-0"><%= t("chatbot.subtitle") %></p>
      </div>
    </div>

    <div class="cxp-header-actions">
      <%= button_to t("chatbot.actions.new_chat"), chatbot_new_path, method: :post,
            class: "btn btn-sm btn-outline-secondary",
            form: { data: { turbo_confirm: t("chatbot.actions.new_chat_confirm") } } %>
      <% if @messages.any? %>
        <%= button_to t("chatbot.actions.clear"), chatbot_clear_path, method: :delete,
              class: "btn btn-sm btn-outline-danger",
              form: { data: { turbo_confirm: t("chatbot.actions.clear_confirm") } } %>
      <% end %>
    </div>
  </div>

  <%# ── Disclaimer ─────────────────────────────────────────────────────────── %>
  <div class="cxp-disclaimer">
    <i class="bi bi-shield-check me-1"></i>
    <%= t("chatbot.disclaimer_body") %>
  </div>

  <%# ── Thread ─────────────────────────────────────────────────────────────── %>
  <div class="cxp-thread" id="chat-thread" data-chatbot-target="thread">

    <% if @messages.empty? %>
      <div class="cxp-empty">
        <div class="cxp-avatar cxp-avatar--xl mb-3"><i class="bi bi-stars"></i></div>
        <p class="fw-semibold mb-1"><%= t("chatbot.empty.title") %></p>
        <p class="text-muted small mb-0"><%= t("chatbot.empty.hint") %></p>
      </div>
    <% else %>
      <% @messages.each do |message| %>
        <%= render partial: "chatbot/message", locals: { message: message } %>
      <% end %>
    <% end %>

  </div>

  <%# ── Composer ───────────────────────────────────────────────────────────── %>
  <div class="cxp-composer">
    <%= form_with url: chatbot_ask_path,
          method: :post,
          data: { chatbot_target: "form", action: "submit->chatbot#submit" } do |f| %>

      <%= f.text_field :query,
            class: "cxp-input",
            placeholder: t("chatbot.form.placeholder"),
            autocomplete: "off",
            maxlength: 400,
            "data-chatbot-target" => "input" %>

      <button type="submit" class="cxp-send-btn" aria-label="<%= t("chatbot.form.submit") %>">
        <i class="bi bi-arrow-up" data-chatbot-target="sendIcon"></i>
        <span data-chatbot-target="spinner" hidden>
          <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        </span>
      </button>

    <% end %>

    <p class="cxp-composer-hint"><%= t("chatbot.form.scope_hint") %></p>
  </div>

</div>
