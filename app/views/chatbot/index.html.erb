<div class="page-shell">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("chatbot.title") %></h1>
      <div class="page-subtitle"><%= t("chatbot.subtitle") %></div>
    </div>
  </div>

  <div class="content-card mb-4">
    <div class="alert alert-warning rounded-4 mb-0" role="alert">
      <strong><%= t("chatbot.disclaimer_title") %></strong>
      <div class="mt-1"><%= t("chatbot.disclaimer_body") %></div>
    </div>
  </div>

  <div class="content-card mb-4">
    <%= form_with url: chatbot_path, method: :post, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :query, t("chatbot.form.label"), class: "form-label" %>
        <%= f.text_field :query,
              value: @query,
              class: "form-control",
              placeholder: t("chatbot.form.placeholder"),
              autocomplete: "off" %>
      </div>

      <div class="d-flex flex-wrap gap-2 align-items-center">
        <%= f.submit t("chatbot.form.submit"), class: "btn btn-primary" %>
        <span class="text-muted small"><%= t("chatbot.form.scope_hint") %></span>
      </div>
    <% end %>
  </div>

  <% if request.post? %>
    <div class="content-card">
      <h2 class="section-title mb-3"><%= t("chatbot.response.title") %></h2>

      <% if @chatbot_response&.dig(:error).present? %>
        <div class="alert alert-danger rounded-4 mb-0"><%= @chatbot_response[:error] %></div>
      <% else %>
        <div class="chatbot-response-grid">
          <div class="content-card p-3 shadow-none border mb-3">
            <div class="text-muted small mb-1"><%= t("chatbot.response.medicine_name") %></div>
            <div class="fw-semibold"><%= @chatbot_response[:medicine_name] %></div>
          </div>

          <div class="content-card p-3 shadow-none border mb-3">
            <h3 class="h6 mb-2"><%= t("chatbot.response.description") %></h3>
            <p class="mb-0"><%= @chatbot_response[:description] %></p>
          </div>

          <div class="content-card p-3 shadow-none border mb-3">
            <h3 class="h6 mb-2"><%= t("chatbot.response.common_uses") %></h3>
            <ul class="mb-0">
              <% @chatbot_response[:common_uses].each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </div>

          <div class="content-card p-3 shadow-none border mb-3">
            <h3 class="h6 mb-2"><%= t("chatbot.response.general_warnings") %></h3>
            <ul class="mb-0">
              <% @chatbot_response[:general_warnings].each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </div>

          <div class="content-card p-3 shadow-none border mb-0">
            <h3 class="h6 mb-2"><%= t("chatbot.response.common_side_effects") %></h3>
            <ul class="mb-0">
              <% @chatbot_response[:common_side_effects].each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
