<%# One chat turn — user (right) or assistant (left). Used by the full-page chatbot
    and appended via Turbo Stream after each AI response. %>
<div class="cmsg cmsg--<%= message.user? ? "user" : "ai" %>" id="<%= dom_id(message) %>">

  <% if message.user? %>
    <div class="cmsg-bubble cmsg-bubble--user"><%= message.content %></div>
    <div class="cmsg-ts cmsg-ts--right"><%= message.created_at.strftime("%H:%M") %></div>

  <% else %>
    <div class="cmsg-row">
      <div class="cmsg-avatar"><i class="bi bi-stars"></i></div>

      <div class="cmsg-col">
        <% res = message.parsed_response %>

        <% if message.error_message? || res.blank? %>
          <div class="cmsg-bubble cmsg-bubble--ai cmsg-bubble--error"><%= message.content %></div>

        <% else %>
          <div class="cmsg-bubble cmsg-bubble--ai">

            <% if res[:medicine_name].present? %>
              <p class="cmsg-label"><%=t "chatbot.response.medicine_name" %></p>
              <p class="cmsg-drug-name"><%= res[:medicine_name] %></p>
            <% end %>

            <% if res[:description].present? %>
              <p class="cmsg-body"><%= res[:description] %></p>
            <% end %>

            <% if Array(res[:common_uses]).any? %>
              <p class="cmsg-label"><%=t "chatbot.response.common_uses" %></p>
              <ul class="cmsg-list">
                <% Array(res[:common_uses]).each do |i| %><li><%= i %></li><% end %>
              </ul>
            <% end %>

            <% if Array(res[:common_side_effects]).any? %>
              <p class="cmsg-label"><%=t "chatbot.response.common_side_effects" %></p>
              <ul class="cmsg-list">
                <% Array(res[:common_side_effects]).each do |i| %><li><%= i %></li><% end %>
              </ul>
            <% end %>

            <% if Array(res[:drug_interactions]).any? %>
              <p class="cmsg-label"><%=t "chatbot.response.drug_interactions" %></p>
              <ul class="cmsg-list">
                <% Array(res[:drug_interactions]).each do |i| %><li><%= i %></li><% end %>
              </ul>
            <% end %>

            <% if Array(res[:general_warnings]).any? %>
              <p class="cmsg-label"><%=t "chatbot.response.general_warnings" %></p>
              <ul class="cmsg-list">
                <% Array(res[:general_warnings]).each do |i| %><li><%= i %></li><% end %>
              </ul>
            <% end %>

            <% if res[:dosage_notes].present? %>
              <p class="cmsg-label"><%=t "chatbot.response.dosage_notes" %></p>
              <p class="cmsg-body"><%= res[:dosage_notes] %></p>
            <% end %>

            <% if res[:disclaimer].present? %>
              <p class="cmsg-disclaimer"><i class="bi bi-info-circle me-1"></i><%= res[:disclaimer] %></p>
            <% end %>

          </div>
        <% end %>

        <div class="cmsg-ts"><%= message.created_at.strftime("%H:%M") %></div>
      </div>
    </div>
  <% end %>

</div>
