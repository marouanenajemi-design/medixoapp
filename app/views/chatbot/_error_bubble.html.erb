<%# Standalone error bubble appended to the chat thread via Turbo Stream. %>
<div class="chat-message chat-message--assistant">
  <div class="chat-bubble-row">
    <div class="chat-avatar" aria-hidden="true"><i class="bi bi-stars"></i></div>
    <div class="chat-bubble-col">
      <div class="chat-bubble chat-bubble--assistant chat-bubble--error"><%= message %></div>
    </div>
  </div>
</div>
