<%# Widget error bubble appended via Turbo Stream. %>
<div class="wm wm--assistant">
  <div class="wm-row">
    <div class="wm-avatar" aria-hidden="true"><i class="bi bi-stars"></i></div>
    <div class="wm-col">
      <div class="wm-bubble wm-bubble--assistant wm-bubble--error"><%= message %></div>
    </div>
  </div>
</div>
