<%# Compact chat rendered inside the floating widget's Turbo Frame.
    No layout — Turbo Frame extracts only the matching <turbo-frame> tag. %>
<turbo-frame id="cfab-widget-frame">

  <div class="cfab-thread" id="cfab-thread">
    <% if @messages.empty? %>
      <div class="cfab-empty">
        <i class="bi bi-stars"></i>
        <p><%= t("chatbot.empty.hint") %></p>
      </div>
    <% else %>
      <% @messages.each do |msg| %>
        <div class="cfab-msg cfab-msg--<%= msg.user? ? "user" : "ai" %>">
          <% if msg.user? %>
            <div class="cfab-bubble cfab-bubble--user"><%= msg.content %></div>
            <div class="cfab-ts cfab-ts--right"><%= msg.created_at.strftime("%H:%M") %></div>
          <% else %>
            <div class="cfab-row">
              <div class="cfab-avatar"><i class="bi bi-stars"></i></div>
              <div class="cfab-col">
                <% res = msg.parsed_response %>
                <% if msg.error_message? || res.blank? %>
                  <div class="cfab-bubble cfab-bubble--ai cfab-bubble--error"><%= msg.content %></div>
                <% else %>
                  <div class="cfab-bubble cfab-bubble--ai">
                    <% if res[:medicine_name].present? %>
                      <strong class="cfab-drug"><%= res[:medicine_name] %></strong>
                    <% end %>
                    <% if res[:description].present? %>
                      <p class="cfab-desc"><%= res[:description] %></p>
                    <% end %>
                    <% if Array(res[:common_uses]).any? %>
                      <p class="cfab-section">Uses</p>
                      <ul class="cfab-list">
                        <% Array(res[:common_uses]).first(3).each do |i| %><li><%= i %></li><% end %>
                      </ul>
                    <% end %>
                    <% if Array(res[:common_side_effects]).any? %>
                      <p class="cfab-section">Side effects</p>
                      <ul class="cfab-list">
                        <% Array(res[:common_side_effects]).first(2).each do |i| %><li><%= i %></li><% end %>
                      </ul>
                    <% end %>
                    <% if res[:disclaimer].present? %>
                      <p class="cfab-disc"><%= res[:disclaimer] %></p>
                    <% end %>
                  </div>
                <% end %>
                <div class="cfab-ts"><%= msg.created_at.strftime("%H:%M") %></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <form action="<%= chatbot_widget_ask_path(locale: I18n.locale) %>"
        method="post"
        class="cfab-composer"
        data-turbo-frame="cfab-widget-frame">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <input type="text"
           name="query"
           class="cfab-input"
           placeholder="<%= t("chatbot.form.placeholder", default: "Ask about a medicine…") %>"
           autocomplete="off"
           required>
    <button type="submit" class="cfab-send-btn" aria-label="Send">
      <i class="bi bi-arrow-up"></i>
    </button>
  </form>

</turbo-frame>
