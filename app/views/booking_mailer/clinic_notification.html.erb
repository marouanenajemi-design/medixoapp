<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    body { margin:0; padding:0; background:#f0fdf9; font-family: Inter, system-ui, sans-serif; color:#0f172a; }
    .wrap { max-width:560px; margin:32px auto; background:#fff; border-radius:20px; overflow:hidden; box-shadow:0 8px 24px rgba(15,23,42,0.08); }
    .header { background:linear-gradient(135deg,#0d9488,#14b8a6); padding:28px 32px; }
    .header-brand { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
    .brand-icon { width:36px; height:36px; border-radius:10px; background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; color:white; font-size:1.1rem; }
    .brand-name { color:white; font-size:1rem; font-weight:800; }
    .header-title { color:white; font-size:1.3rem; font-weight:800; margin:0; }
    .header-sub { color:rgba(255,255,255,0.8); font-size:0.88rem; margin:6px 0 0; }
    .body { padding:28px 32px; }
    .detail-row { display:flex; gap:12px; padding:12px 0; border-bottom:1px solid #f1f5f9; }
    .detail-row:last-child { border-bottom:none; }
    .detail-label { font-size:0.78rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:0.4px; min-width:100px; padding-top:2px; }
    .detail-value { font-size:0.92rem; font-weight:600; color:#0f172a; }
    .badge { display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:999px; background:#fef3c7; color:#92400e; font-size:0.8rem; font-weight:700; }
    .cta { display:block; margin:24px 0 0; text-align:center; }
    .cta a { display:inline-block; padding:12px 28px; background:linear-gradient(135deg,#0d9488,#14b8a6); color:white; text-decoration:none; border-radius:12px; font-weight:700; font-size:0.95rem; }
    .footer { background:#f8fafc; padding:18px 32px; text-align:center; font-size:0.78rem; color:#94a3b8; }
  </style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="header-brand">
      <div class="brand-icon">&#9829;</div>
      <span class="brand-name">MedixoApp</span>
    </div>
    <h1 class="header-title">New Online Booking</h1>
    <p class="header-sub">A patient has booked an appointment through your clinic page.</p>
  </div>

  <div class="body">
    <div class="detail-row">
      <span class="detail-label">Patient</span>
      <span class="detail-value"><%= @patient_name %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Email</span>
      <span class="detail-value"><%= @patient_email %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Doctor</span>
      <span class="detail-value"><%= @doctor.name %> — <%= @doctor.specialty %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Date</span>
      <span class="detail-value"><%= @appointment.appointment_date.strftime("%A, %B %d, %Y") %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Time</span>
      <span class="detail-value"><%= @appointment.appointment_time.strftime("%H:%M") %></span>
    </div>
    <% if @appointment.notes.present? %>
    <div class="detail-row">
      <span class="detail-label">Reason</span>
      <span class="detail-value"><%= @appointment.notes %></span>
    </div>
    <% end %>
    <div class="detail-row">
      <span class="detail-label">Status</span>
      <span class="detail-value"><span class="badge">&#9203; Pending Approval</span></span>
    </div>

    <div class="cta">
      <a href="<%= appointments_url(locale: I18n.locale) %>">Review &amp; Confirm Booking →</a>
    </div>
  </div>

  <div class="footer">
    MedixoApp · <%= @clinic.name %> · This is an automated notification.
  </div>
</div>
</body>
</html>
