<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    body { margin:0; padding:0; background:#f0fdf9; font-family: Inter, system-ui, sans-serif; color:#0f172a; }
    .wrap { max-width:560px; margin:32px auto; background:#fff; border-radius:20px; overflow:hidden; box-shadow:0 8px 24px rgba(15,23,42,0.08); }
    .header { background:linear-gradient(135deg,#0d9488,#14b8a6); padding:28px 32px; }
    .header-brand { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
    .brand-icon { width:36px; height:36px; border-radius:10px; background:rgba(255,255,255,0.2); display:inline-flex; align-items:center; justify-content:center; color:white; font-size:1.1rem; }
    .brand-name { color:white; font-size:1rem; font-weight:800; }
    .check-icon { width:56px; height:56px; border-radius:50%; background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; margin:0 0 16px; }
    .check-icon span { color:white; font-size:1.6rem; font-weight:700; }
    .header-title { color:white; font-size:1.3rem; font-weight:800; margin:0; }
    .header-sub { color:rgba(255,255,255,0.85); font-size:0.9rem; margin:6px 0 0; }
    .body { padding:28px 32px; }
    .greeting { font-size:1rem; font-weight:700; color:#0f172a; margin:0 0 8px; }
    .intro { font-size:0.92rem; color:#475569; margin:0 0 24px; line-height:1.6; }
    .detail-row { display:flex; gap:12px; padding:12px 0; border-bottom:1px solid #f1f5f9; }
    .detail-row:last-child { border-bottom:none; }
    .detail-label { font-size:0.75rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:0.4px; min-width:90px; padding-top:2px; }
    .detail-value { font-size:0.92rem; font-weight:600; color:#0f172a; }
    .closing { font-size:0.88rem; color:#64748b; margin:20px 0 0; line-height:1.6; }
    .footer { background:#f8fafc; padding:18px 32px; text-align:center; font-size:0.78rem; color:#94a3b8; }
  </style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="header-brand">
      <div class="brand-icon">&#9829;</div>
      <span class="brand-name">MedixoApp</span>
    </div>
    <div class="check-icon"><span>&#10003;</span></div>
    <h1 class="header-title"><%= t("booking_mailer.patient_confirmed.subject") %></h1>
    <p class="header-sub"><%= @clinic.name %></p>
  </div>

  <div class="body">
    <p class="greeting"><%= t("booking_mailer.patient_confirmed.greeting", name: @patient_name) %></p>
    <p class="intro"><%= t("booking_mailer.patient_confirmed.intro", clinic: @clinic.name) %></p>

    <div class="detail-row">
      <span class="detail-label"><%= t("booking_mailer.patient_confirmed.label_doctor") %></span>
      <span class="detail-value"><%= @doctor.name %><% if @doctor.specialty.present? %> — <%= @doctor.specialty %><% end %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label"><%= t("booking_mailer.patient_confirmed.label_date") %></span>
      <span class="detail-value"><%= @appointment.appointment_date.strftime("%A, %B %d, %Y") %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label"><%= t("booking_mailer.patient_confirmed.label_time") %></span>
      <span class="detail-value"><%= @appointment.appointment_time.strftime("%H:%M") %></span>
    </div>
    <% if @clinic.address.present? %>
    <div class="detail-row">
      <span class="detail-label"><%= t("booking_mailer.patient_confirmed.label_address") %></span>
      <span class="detail-value"><%= @clinic.address %></span>
    </div>
    <% end %>
    <% if @clinic.phone.present? %>
    <div class="detail-row">
      <span class="detail-label"><%= t("booking_mailer.patient_confirmed.label_phone") %></span>
      <span class="detail-value"><%= @clinic.phone %></span>
    </div>
    <% end %>

    <p class="closing"><%= t("booking_mailer.patient_confirmed.closing") %></p>
  </div>

  <div class="footer">
    MedixoApp &middot; <%= @clinic.name %> &middot; This is an automated notification.
  </div>
</div>
</body>
</html>
