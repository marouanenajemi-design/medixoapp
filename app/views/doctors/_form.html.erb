<%= form_with(model: @doctor, local: true) do |f| %>
  <% if @doctor.errors.any? %>
    <div class="alert alert-danger rounded-4 form-errors">
      <strong><%= form_errors_heading %></strong>
      <ul class="mb-0 mt-2">
        <% @doctor.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: t("doctors.form.placeholders.name") %>
  </div>

  <div class="mb-3">
    <%= f.label :specialty, class: "form-label" %>
    <%= f.text_field :specialty, class: "form-control", placeholder: t("doctors.form.placeholders.specialty") %>
  </div>

  <div class="mb-3">
    <%= f.label :phone, class: "form-label" %>
    <%= f.text_field :phone, class: "form-control", placeholder: t("shared.placeholders.phone") %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :work_start, class: "form-label" %>
      <%= f.time_field :work_start, class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :work_end, class: "form-label" %>
      <%= f.time_field :work_end, class: "form-control" %>
    </div>
  </div>

  <div class="mt-4">
    <%= f.submit t("shared.actions.save_doctor"), class: "btn btn-primary" %>
  </div>
<% end %>
