<% content_for :page_title, t("bookings.confirmation.title") %>

<div class="booking-confirmation">
  <div class="booking-confirmation-icon">
    <i class="bi bi-check-lg"></i>
  </div>
  <h1 class="booking-confirmation-title"><%= t("bookings.confirmation.heading") %></h1>
  <p class="booking-confirmation-sub"><%= t("bookings.confirmation.body") %></p>

  <div class="booking-confirmation-badge">
    <i class="bi bi-hourglass-split"></i>
    <%= t("bookings.confirmation.pending_notice") %>
  </div>

  <div style="display:flex;align-items:center;justify-content:center;gap:8px;font-size:0.88rem;color:#64748b;max-width:380px;margin:0 auto;line-height:1.6;">
    <i class="bi bi-envelope" style="color:#14b8a6;flex-shrink:0;font-size:1rem;"></i>
    <span><%= t("bookings.confirmation.email_reply") %></span>
  </div>
</div>
