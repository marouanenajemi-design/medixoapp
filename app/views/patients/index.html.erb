<div class="page-shell">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("patients.index.title") %></h1>
      <div class="page-subtitle"><%= t("patients.index.subtitle") %></div>
    </div>

    <div class="page-actions">
      <%= link_to t("shared.actions.add_patient"), new_patient_path, class: "btn btn-primary action-btn" %>
    </div>
  </div>

  <div class="content-card" data-controller="filter-list">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <h2 class="section-title mb-0"><%= t("patients.index.list_title") %></h2>

      <div class="search-box">
        <input
          type="text"
          class="search-input"
          placeholder="<%= t("patients.index.search_placeholder") %>"
          data-filter-list-target="input"
          data-action="input->filter-list#filter"
        >
      </div>
    </div>

    <% if @patients.any? %>
      <div class="table-responsive">
        <table class="table table-clean responsive-table">
          <thead>
            <tr>
              <th><%= t("shared.tables.name") %></th>
              <th><%= t("shared.tables.phone") %></th>
              <th><%= t("patients.fields.age") %></th>
              <th><%= t("patients.fields.gender") %></th>
              <th><%= t("shared.tables.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @patients.each do |patient| %>
              <tr data-filter-list-target="row" data-filter-list-searchable-value="<%= patient.name.downcase %>">
                <td class="fw-semibold" data-label="<%= t("shared.tables.name") %>"><%= patient.name %></td>
                <td data-label="<%= t("shared.tables.phone") %>"><%= patient.phone %></td>
                <td data-label="<%= t("patients.fields.age") %>"><%= patient.age %></td>
                <td data-label="<%= t("patients.fields.gender") %>"><%= patient_gender_label(patient.gender) %></td>
                <td class="actions-cell" data-label="<%= t("shared.tables.actions") %>">
                  <div class="action-group">
                    <%= link_to t("shared.actions.history"), history_patient_path(patient), class: "btn btn-sm btn-outline-secondary" %>
                    <%= link_to t("shared.actions.edit"), edit_patient_path(patient), class: "btn btn-sm btn-warning" %>
                    <%= link_to t("shared.actions.delete"),
                          patient_path(patient),
                          data: { turbo_method: :delete, turbo_confirm: t("shared.confirmations.delete") },
                          class: "btn btn-sm btn-danger" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="empty-state" style="display:none;" data-filter-list-target="empty">
        <%= t("patients.index.search_empty") %>
      </div>
    <% else %>
      <div class="empty-state"><%= t("patients.index.empty") %></div>
    <% end %>
  </div>
</div>
