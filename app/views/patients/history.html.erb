<div class="page-shell">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("patients.history.title") %></h1>
      <div class="page-subtitle"><%= @patient.name %></div>
    </div>

    <div class="page-actions">
      <%= link_to t("patients.history.back"), patients_path, class: "btn btn-outline-primary action-btn" %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="content-card">
        <h2 class="section-title"><%= t("navigation.appointments") %></h2>

        <% if @appointments.any? %>
          <div class="table-responsive">
            <table class="table table-clean responsive-table">
              <thead>
                <tr>
                  <th><%= t("shared.tables.date") %></th>
                  <th><%= t("shared.tables.doctor") %></th>
                  <th><%= t("shared.tables.status") %></th>
                </tr>
              </thead>
              <tbody>
                <% @appointments.each do |appointment| %>
                  <% badge_class =
                    case appointment.status
                    when "confirmed" then "badge-confirmed"
                    when "pending" then "badge-pending"
                    when "completed" then "badge-completed"
                    when "cancelled" then "badge-cancelled"
                    else "badge-completed"
                    end
                  %>

                  <tr>
                    <td data-label="<%= t("shared.tables.date") %>">
                      <%= appointment.appointment_date %>
                      <% if appointment.appointment_time.present? %>
                        - <%= formatted_time(appointment.appointment_time) %>
                      <% end %>
                    </td>
                    <td data-label="<%= t("shared.tables.doctor") %>"><%= appointment.doctor.name %></td>
                    <td data-label="<%= t("shared.tables.status") %>">
                      <span class="badge-soft <%= badge_class %>"><%= appointment_status_label(appointment.status) %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty-state"><%= t("patients.history.empty_appointments") %></div>
        <% end %>
      </div>
    </div>

    <div class="col-md-6">
      <div class="content-card">
        <h2 class="section-title"><%= t("navigation.prescriptions") %></h2>

        <% if @prescriptions.any? %>
          <div class="table-responsive">
            <table class="table table-clean responsive-table">
              <thead>
                <tr>
                  <th><%= t("shared.tables.date") %></th>
                  <th><%= t("shared.tables.doctor") %></th>
                  <th><%= t("shared.tables.action") %></th>
                </tr>
              </thead>
              <tbody>
                <% @prescriptions.each do |prescription| %>
                  <tr>
                    <td data-label="<%= t("shared.tables.date") %>"><%= prescription.prescription_date %></td>
                    <td data-label="<%= t("shared.tables.doctor") %>"><%= prescription.doctor.name %></td>
                    <td class="actions-cell" data-label="<%= t("shared.tables.action") %>">
                      <%= link_to t("shared.actions.open"), prescription_path(prescription), class: "btn btn-sm btn-primary" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty-state"><%= t("patients.history.empty_prescriptions") %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
