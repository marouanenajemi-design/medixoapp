<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("admin.layout.title") %> — <%= t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-visit-control" content="reload">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
      /* ── Shared base (mirrors application layout) ── */
      body {
        margin: 0;
        background: #f4f7fb;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #0f172a;
      }
      body.sidebar-open { overflow: hidden; }

      .app-shell { display: flex; min-height: 100vh; }

      .sidebar {
        width: 260px;
        min-height: 100vh;
        padding: 28px 18px;
        flex-shrink: 0;
        overflow-y: auto;
        /* Admin sidebar: deep indigo/purple instead of navy */
        background: linear-gradient(180deg, #12082a 0%, #1e0a3c 100%);
      }

      .sidebar a {
        color: #cbd5e1;
        text-decoration: none;
        display: flex;
        align-items: center;
        padding: 14px 18px;
        border-radius: 16px;
        margin-bottom: 10px;
        font-size: 1.02rem;
        font-weight: 500;
        gap: 10px;
        transition: 0.22s ease;
      }
      .sidebar a:hover,
      .sidebar a.active {
        background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
        color: white;
      }

      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 2rem;
        text-decoration: none;
      }

      .admin-brand-mark {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
        color: #1a0b2e;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 900;
        box-shadow: 0 8px 20px rgba(245, 158, 11, 0.35);
        flex-shrink: 0;
      }

      .admin-brand-text { display: flex; flex-direction: column; line-height: 1.15; }
      .admin-brand-name { color: #fff; font-size: 1.1rem; font-weight: 800; }
      .admin-brand-badge {
        display: inline-block;
        background: rgba(245, 158, 11, 0.18);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #fbbf24;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 999px;
        margin-top: 3px;
      }

      .admin-divider {
        border: none;
        border-top: 1px solid rgba(255,255,255,0.08);
        margin: 10px 0 16px;
      }

      .sidebar-section-label {
        color: #64748b;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        padding: 0 18px;
        margin-bottom: 8px;
      }

      .sidebar-toggle, .sidebar-close, .sidebar-backdrop { display: none; }
      .sidebar-toggle, .sidebar-close {
        width: 46px; height: 46px;
        border-radius: 14px;
        border: 1px solid #dbe3ef;
        background: white; color: #0f172a;
        align-items: center; justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
      }

      .main-content { flex: 1; min-width: 0; }

      .topbar {
        background: rgba(255,255,255,0.95);
        border-bottom: 1px solid #e2e8f0;
        backdrop-filter: blur(10px);
      }
      .topbar-title { font-size: 1.1rem; font-weight: 800; color: #0f172a; }
      .topbar-subtitle { font-size: 0.88rem; color: #64748b; }
      .topbar-user { min-width: 0; text-align: right; }
      .topbar-user-email { font-weight: 600; word-break: break-word; }

      .admin-topbar-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: #1a0b2e;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
      }

      .page-shell { padding: 30px; }
      .page-header {
        display: flex; justify-content: space-between;
        align-items: center; margin-bottom: 26px; gap: 18px;
      }
      .page-title { font-size: 2rem; font-weight: 800; margin: 0; letter-spacing: -0.7px; }
      .page-subtitle { color: #64748b; margin-top: 6px; font-size: 1rem; }

      .stat-card, .content-card, .form-card {
        border: none; border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        padding: 28px;
        transition: all 0.25s ease;
      }
      .stat-card:hover, .content-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12); }
      .stat-label { color: #64748b; font-weight: 600; margin-bottom: 12px; font-size: 1rem; }
      .stat-value { font-size: 2.2rem; font-weight: 800; color: #0f172a; }
      .stat-sub { font-size: 0.85rem; color: #94a3b8; margin-top: 4px; }

      .table-clean { margin-bottom: 0; }
      .table-clean thead th {
        border-bottom: 1px solid #e2e8f0; color: #334155;
        font-size: 0.98rem; font-weight: 700;
        padding: 18px 14px; background: transparent;
      }
      .table-clean tbody td {
        padding: 16px 14px; border-bottom: 1px solid #eef2f7;
        color: #0f172a; vertical-align: middle;
      }

      .badge-soft {
        display: inline-block; padding: 5px 11px;
        border-radius: 999px; font-size: 0.82rem; font-weight: 700;
      }
      .badge-subscribed  { background: #dcfce7; color: #166534; }
      .badge-trialing    { background: #fef3c7; color: #92400e; }
      .badge-expired     { background: #fee2e2; color: #b91c1c; }
      .badge-admin       { background: #fef3c7; color: #92400e; }
      .badge-user        { background: #f1f5f9; color: #475569; }
      .badge-confirmed   { background: #dcfce7; color: #166534; }
      .badge-pending     { background: #fef3c7; color: #92400e; }
      .badge-completed   { background: #dbeafe; color: #1d4ed8; }
      .badge-cancelled   { background: #fee2e2; color: #b91c1c; }

      .btn-primary {
        background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
        border: none; border-radius: 16px; min-height: 48px;
        font-weight: 700; padding: 0 22px; color: white;
        display: inline-flex; align-items: center; justify-content: center;
        line-height: 1; box-shadow: 0 8px 18px rgba(124, 58, 237, 0.28);
        transition: all 0.25s ease; text-decoration: none;
      }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 28px rgba(124, 58, 237, 0.38); color: white; }

      .btn-warning, .btn-danger, .btn-success {
        border-radius: 12px; font-weight: 600;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s ease;
      }
      .btn-sm { min-height: 36px; padding: 0 14px; font-size: 0.88rem; }
      .btn-sm:hover { transform: translateY(-2px); }

      .btn-outline-secondary {
        border-radius: 12px; font-weight: 600;
        min-height: 38px;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s ease;
        text-decoration: none;
      }
      .btn-outline-secondary:hover { transform: translateY(-2px); }

      .action-group { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .action-group .button_to { margin: 0; }

      .section-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 20px; }
      .empty-state { text-align: center; padding: 35px 20px; color: #64748b; }

      .detail-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
      }
      .detail-item { background: #f8fafc; border-radius: 16px; padding: 16px 20px; }
      .detail-label { font-size: 0.82rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
      .detail-value { font-size: 1.05rem; font-weight: 600; color: #0f172a; }

      .locale-link {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 40px; padding: 7px 11px;
        border-radius: 999px; border: 1px solid #dbe3ef;
        background: white; color: #334155;
        font-size: 0.82rem; font-weight: 700;
        text-decoration: none; text-transform: uppercase;
      }
      .locale-link.active { background: #7c3aed; border-color: #7c3aed; color: white; }

      .responsive-table { width: 100%; }

      @media (max-width: 991px) {
        .app-shell { display: block; }
        .sidebar-backdrop {
          display: block; position: fixed; inset: 0;
          border: none; background: rgba(15, 23, 42, 0.55);
          opacity: 0; pointer-events: none;
          transition: opacity 0.2s ease; z-index: 1030;
        }
        body.sidebar-open .sidebar-backdrop { opacity: 1; pointer-events: auto; }
        .sidebar {
          position: fixed; top: 0; left: 0; bottom: 0;
          width: min(84vw, 320px); min-height: 100vh;
          z-index: 1040; transform: translateX(-105%);
          transition: transform 0.24s ease;
          box-shadow: 0 18px 40px rgba(15, 23, 42, 0.32);
        }
        body.sidebar-open .sidebar { transform: translateX(0); }
        .sidebar-close, .sidebar-toggle { display: inline-flex; }
        .sidebar-close {
          margin-left: auto; margin-bottom: 18px;
          background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.12); color: white;
        }
        .topbar { position: sticky; top: 0; z-index: 1020; }
        .page-shell { padding: 22px 16px 32px; }
        .page-header { flex-direction: column; align-items: stretch; }
        .stat-card, .content-card { padding: 22px; border-radius: 20px; }
        .detail-grid { grid-template-columns: 1fr; }
      }
      @media (max-width: 767px) {
        .page-title { font-size: 1.65rem; }
        .section-title { font-size: 1.3rem; }
        .topbar { padding: 14px 16px !important; }
        .topbar-user { text-align: left; width: 100%; }
        .table-responsive { overflow-x: auto; }
        .responsive-table thead { display: none; }
        .responsive-table, .responsive-table tbody, .responsive-table tr, .responsive-table td { display: block; width: 100%; }
        .responsive-table tbody { display: grid; gap: 14px; }
        .responsive-table tr { padding: 18px; border: 1px solid #e2e8f0; border-radius: 20px; background: #fff; box-shadow: 0 8px 24px rgba(15,23,42,0.06); }
        .responsive-table td { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; border: none !important; padding: 10px 0 !important; }
        .responsive-table td::before { content: attr(data-label); color: #475569; font-weight: 700; flex: 0 0 42%; }
        .responsive-table td.actions-cell { display: block; padding-top: 14px !important; }
        .responsive-table td.actions-cell::before { display: block; margin-bottom: 10px; }
        .action-group { width: 100%; }
      }
    </style>
  </head>

  <body data-controller="sidebar" data-action="resize@window->sidebar#handleResize">
    <button type="button" class="sidebar-backdrop" data-action="sidebar#close"></button>

    <div class="app-shell">
      <div class="sidebar" id="appSidebar" data-sidebar-target="panel" data-action="click->sidebar#closeFromSidebar submit->sidebar#close">
        <button type="button" class="sidebar-close" data-action="sidebar#close">
          <i class="bi bi-x-lg"></i>
        </button>

        <%= link_to admin_root_path, class: "sidebar-brand", data: { turbo: false } do %>
          <div class="admin-brand-mark"><i class="bi bi-shield-fill-check"></i></div>
          <div class="admin-brand-text">
            <span class="admin-brand-name"><%= t("app.name") %></span>
            <span class="admin-brand-badge"><%= t("admin.layout.badge") %></span>
          </div>
        <% end %>

        <hr class="admin-divider">

        <div class="sidebar-section-label mb-2"><%= t("admin.layout.nav_label") %></div>

        <%= link_to admin_root_path, class: "#{'active' if current_page?(admin_root_path)}", data: { turbo: false } do %>
          <i class="bi bi-speedometer2"></i> <%= t("admin.navigation.dashboard") %>
        <% end %>

        <%= link_to admin_users_path, class: "#{'active' if request.path.start_with?('/admin/users')}", data: { turbo: false } do %>
          <i class="bi bi-people"></i> <%= t("admin.navigation.users") %>
        <% end %>

        <%= link_to admin_clinics_path, class: "#{'active' if request.path.start_with?('/admin/clinics')}", data: { turbo: false } do %>
          <i class="bi bi-hospital"></i> <%= t("admin.navigation.clinics") %>
        <% end %>

        <%= link_to admin_doctors_path, class: "#{'active' if request.path.start_with?('/admin/doctors')}", data: { turbo: false } do %>
          <i class="bi bi-person-badge"></i> <%= t("admin.navigation.doctors") %>
        <% end %>

        <%= link_to admin_patients_path, class: "#{'active' if request.path.start_with?('/admin/patients')}", data: { turbo: false } do %>
          <i class="bi bi-heart-pulse"></i> <%= t("admin.navigation.patients") %>
        <% end %>

        <%= link_to admin_appointments_path, class: "#{'active' if request.path.start_with?('/admin/appointments')}", data: { turbo: false } do %>
          <i class="bi bi-calendar-check"></i> <%= t("admin.navigation.appointments") %>
        <% end %>

        <hr class="admin-divider mt-2">

        <% if current_user.clinic.present? %>
          <%= link_to dashboard_path, data: { turbo: false } do %>
            <i class="bi bi-arrow-left-circle"></i> <%= t("admin.navigation.back_to_app") %>
          <% end %>
        <% end %>

        <%= button_to t("shared.actions.logout"), admin_sign_out_path, method: :delete, class: "btn btn-danger w-100 mt-2", data: { turbo: false } %>
      </div>

      <div class="main-content">
        <div class="topbar px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3 flex-grow-1">
            <button type="button" class="sidebar-toggle" data-action="sidebar#toggle">
              <i class="bi bi-list"></i>
            </button>
            <div>
              <div class="topbar-title"><%= t("admin.layout.topbar_title") %></div>
              <div class="topbar-subtitle"><%= t("admin.layout.topbar_subtitle") %></div>
            </div>
          </div>

          <div class="d-flex align-items-center gap-3 topbar-user">
            <div class="d-flex align-items-center gap-2">
              <% I18n.available_locales.each do |locale| %>
                <%= locale_switch_link(locale) %>
              <% end %>
            </div>
            <div class="admin-topbar-badge">
              <i class="bi bi-shield-fill-check"></i>
              <%= t("admin.layout.badge") %>
            </div>
            <div class="topbar-user-email"><%= current_user.email %></div>
          </div>
        </div>

        <% if notice %>
          <div class="p-3 pb-0">
            <div class="alert alert-success rounded-4"><%= notice %></div>
          </div>
        <% end %>

        <% if alert %>
          <div class="p-3 pb-0">
            <div class="alert alert-danger rounded-4"><%= alert %></div>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
