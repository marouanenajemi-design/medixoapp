<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body data-controller="sidebar" data-action="resize@window->sidebar#handleResize">
    <% auth_page = devise_controller? %>

    <% if user_signed_in? && !auth_page && current_clinic.present? %>
      <button type="button" class="sidebar-backdrop" aria-label="<%= t("layout.navigation.close") %>" data-action="sidebar#close"></button>

      <div class="app-shell">
        <div class="sidebar" id="appSidebar" data-sidebar-target="panel" data-action="click->sidebar#closeFromSidebar submit->sidebar#close">
          <button type="button" class="sidebar-close" aria-label="<%= t("layout.navigation.close") %>" data-action="sidebar#close">
            <i class="bi bi-x-lg"></i>
          </button>

          <%= link_to dashboard_path, class: "sidebar-brand-wrap" do %>
            <div class="brand-mark">
              <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div class="sidebar-brand-text">
              <span class="sidebar-brand-name"><%= t("app.name") %></span>
              <span class="sidebar-brand-sub"><%= t("layout.sidebar.panel") %></span>
            </div>
          <% end %>

          <% if current_clinic.present? %>
            <hr class="sidebar-clinic-divider">
            <div class="sidebar-clinic-block">
              <%= image_tag clinic_brand_image(current_clinic), class: "sidebar-logo", alt: "Clinic logo" %>
              <div>
                <div class="sidebar-clinic-name"><%= current_clinic.name %></div>
                <div class="sidebar-clinic-subtitle">Your clinic</div>
              </div>
            </div>
          <% end %>

          <%= link_to dashboard_path, class: active_path(dashboard_path) do %>
            <i class="bi bi-speedometer2"></i> <%= t("navigation.dashboard") %>
          <% end %>
          <%= link_to doctors_path, class: active_path(doctors_path) do %>
            <i class="bi bi-person-badge"></i> <%= t("navigation.doctors") %>
          <% end %>
          <%= link_to patients_path, class: active_path(patients_path) do %>
            <i class="bi bi-people"></i> <%= t("navigation.patients") %>
          <% end %>
          <%= link_to prescriptions_path, class: active_path(prescriptions_path) do %>
            <i class="bi bi-file-earmark-medical"></i> <%= t("navigation.prescriptions") %>
          <% end %>
          <%= link_to appointments_path, class: active_path(appointments_path) do %>
            <i class="bi bi-calendar-check"></i> <%= t("navigation.appointments") %>
          <% end %>
          <%= link_to calendar_path, class: active_path(calendar_path) do %>
            <i class="bi bi-calendar3"></i> <%= t("navigation.calendar") %>
          <% end %>
          <%= link_to analytics_path, class: active_path(analytics_path) do %>
            <i class="bi bi-bar-chart-line"></i> <%= t("navigation.analytics") %>
            <% unless current_clinic.plan_allows?(:analytics) %>
              <span class="sidebar-plan-badge">PRO</span>
            <% end %>
          <% end %>
          <%= link_to edit_clinic_path, class: active_path(edit_clinic_path) do %>
            <i class="bi bi-gear"></i> <%= t("navigation.clinic_settings") %>
          <% end %>

          <%= button_to t("shared.actions.logout"), destroy_user_session_path, method: :delete, class: "btn btn-danger w-100 mt-4" %>
        </div>

        <div class="main-content">
          <div class="topbar px-4 py-3 d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex align-items-center gap-3 flex-grow-1">
              <button type="button" class="sidebar-toggle" aria-label="<%= t("layout.navigation.open") %>" data-action="sidebar#toggle">
                <i class="bi bi-list"></i>
              </button>

              <div>
                <div class="topbar-title"><%= t("app.name") %></div>
                <div class="topbar-subtitle"><%= t("layout.topbar.subtitle") %></div>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3 topbar-user">
              <div class="d-flex align-items-center gap-2">
                <% I18n.available_locales.each do |locale| %>
                  <%= locale_switch_link(locale) %>
                <% end %>
              </div>

              <%= image_tag clinic_brand_image(current_clinic), class: "clinic-navbar-logo", alt: "Clinic logo" %>

              <div class="topbar-user-email"><%= current_user.email %></div>
            </div>
          </div>

          <% if notice %>
            <div class="p-3 pb-0">
              <div class="alert alert-success rounded-4"><%= notice %></div>
            </div>
          <% end %>

          <% if alert %>
            <div class="p-3 pb-0">
              <div class="alert alert-danger rounded-4"><%= alert %></div>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>

    <% elsif auth_page %>
      <div class="auth-shell">
        <div class="auth-brand-side">
          <div>
            <div class="brand-logo">
              <div class="brand-logo-mark">
                <i class="bi bi-heart-pulse-fill" style="color:white;"></i>
              </div>
              <%= t("app.name") %>
            </div>
            <div class="brand-badge"><%= t("layout.auth.badge") %></div>

            <h1 class="brand-title"><%= t("layout.auth.title") %></h1>
            <p class="brand-text">
              <%= t("layout.auth.description") %>
            </p>

            <div class="brand-features">
              <div class="feature-box">
                <div class="feature-box-icon"><i class="bi bi-calendar-check"></i></div>
                <h6><%= t("layout.auth.features.scheduling.title") %></h6>
                <p><%= t("layout.auth.features.scheduling.description") %></p>
              </div>

              <div class="feature-box">
                <div class="feature-box-icon"><i class="bi bi-people"></i></div>
                <h6><%= t("layout.auth.features.patients.title") %></h6>
                <p><%= t("layout.auth.features.patients.description") %></p>
              </div>

              <div class="feature-box">
                <div class="feature-box-icon"><i class="bi bi-person-badge"></i></div>
                <h6><%= t("layout.auth.features.doctors.title") %></h6>
                <p><%= t("layout.auth.features.doctors.description") %></p>
              </div>

              <div class="feature-box">
                <div class="feature-box-icon"><i class="bi bi-speedometer2"></i></div>
                <h6><%= t("layout.auth.features.dashboard.title") %></h6>
                <p><%= t("layout.auth.features.dashboard.description") %></p>
              </div>
            </div>
          </div>

          <div class="brand-footer">
            <%= t("layout.auth.footer") %>
          </div>
        </div>

        <div class="auth-form-side">
          <div class="auth-panel">
            <div class="d-flex justify-content-end gap-2 mb-3">
              <% I18n.available_locales.each do |locale| %>
                <%= locale_switch_link(locale) %>
              <% end %>
            </div>

            <% if notice %>
              <div class="alert alert-success rounded-4"><%= notice %></div>
            <% end %>

            <% if alert %>
              <div class="alert alert-danger rounded-4"><%= alert %></div>
            <% end %>

            <%= yield %>
          </div>
        </div>
      </div>

    <% else %>
      <div class="container py-5">
        <%= yield %>
      </div>
    <% end %>

<% if user_signed_in? && !auth_page && current_clinic.present? %>
  <div class="floating-chatbot-wrap">
    <div class="chatbot-tooltip">Ask MedixoApp AI</div>

    <button
      type="button"
      class="floating-chatbot-btn"
      id="floatingChatbotButton"
      aria-label="Open AI chatbot"
      title="Open AI chatbot"
    >
      <span class="chatbot-ai-badge">AI</span>
      <i class="bi bi-chat-dots-fill"></i>
    </button>

    <div class="chatbot-popup" id="floatingChatbotPopup">
      <div class="chatbot-popup-header">
        <div class="chatbot-popup-brand">
          <div class="chatbot-popup-icon">
            <i class="bi bi-stars"></i>
          </div>

          <div>
            <p class="chatbot-popup-title">MedixoApp AI</p>
            <p class="chatbot-popup-subtitle">Medicine information assistant</p>
          </div>
        </div>

        <div class="chatbot-popup-actions">
          <a
            href="<%= chatbot_path(locale: I18n.locale) %>"
            class="chatbot-popup-action-btn"
            title="Open full page"
            aria-label="Open full chatbot page"
          >
            <i class="bi bi-box-arrow-up-right"></i>
          </a>

          <button
            type="button"
            class="chatbot-popup-action-btn"
            id="closeFloatingChatbot"
            title="Close"
            aria-label="Close chatbot"
          >
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      </div>

      <iframe
        src="<%= chatbot_widget_path(locale: I18n.locale) %>"
        class="chatbot-popup-frame"
        title="MedixoApp AI Chatbot"
      ></iframe>
    </div>
  </div>

  <script>
    function initFloatingChatbot() {
      const openBtn = document.getElementById("floatingChatbotButton");
      const popup = document.getElementById("floatingChatbotPopup");
      const closeBtn = document.getElementById("closeFloatingChatbot");

      if (!openBtn || !popup || openBtn.dataset.chatbotBound === "true") return;

      openBtn.dataset.chatbotBound = "true";

      openBtn.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        popup.classList.toggle("open");
      });

      if (closeBtn && closeBtn.dataset.chatbotBound !== "true") {
        closeBtn.dataset.chatbotBound = "true";

        closeBtn.addEventListener("click", function (event) {
          event.preventDefault();
          event.stopPropagation();
          popup.classList.remove("open");
        });
      }

      if (!document.body.dataset.chatbotOutsideBound) {
        document.body.dataset.chatbotOutsideBound = "true";

        document.addEventListener("click", function (event) {
          const wrap = document.querySelector(".floating-chatbot-wrap");
          const activePopup = document.getElementById("floatingChatbotPopup");
          if (!wrap || !activePopup) return;

          if (!wrap.contains(event.target)) {
            activePopup.classList.remove("open");
          }
        });

        document.addEventListener("keydown", function (event) {
          const activePopup = document.getElementById("floatingChatbotPopup");
          if (!activePopup) return;

          if (event.key === "Escape") {
            activePopup.classList.remove("open");
          }
        });
      }
    }

    document.addEventListener("DOMContentLoaded", initFloatingChatbot);
    document.addEventListener("turbo:load", initFloatingChatbot);
  </script>
<% end %>
</body>
</html>
