<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.15/locales-all.global.min.js"></script>

    <style>
      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: 900;
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.25);
        flex-shrink: 0;
      }

      .sidebar-brand-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 2.2rem;
        text-decoration: none;
      }

      .sidebar-brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
      }

      .sidebar-brand-name {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      .sidebar-clinic-name {
        color: white;
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.1;
      }

      .sidebar-clinic-subtitle {
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 500;
        margin-top: 2px;
      }

      .auth-brand-top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
      }

      .auth-brand-name {
        font-size: 2.2rem;
        font-weight: 800;
      }

      .topbar-app-name {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .topbar-app-title {
        margin: 0;
        font-weight: 800;
        font-size: 1.4rem;
      }

      body {
        margin: 0;
        background: #f4f7fb;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #0f172a;
      }

      body.sidebar-open {
        overflow: hidden;
      }

      .app-shell {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        width: 260px;
        min-height: 100vh;
        background: linear-gradient(180deg, #081028 0%, #0b1736 100%);
        padding: 28px 18px;
        flex-shrink: 0;
        overflow-y: auto;
      }

      .sidebar-brand {
        color: #fff;
        font-size: 2rem;
        font-weight: 800;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 2.2rem;
        letter-spacing: -0.5px;
      }

      .sidebar a {
        color: #cbd5e1;
        text-decoration: none;
        display: flex;
        align-items: center;
        padding: 14px 18px;
        border-radius: 16px;
        margin-bottom: 12px;
        font-size: 1.05rem;
        font-weight: 500;
        transition: 0.25s ease;
      }

      .sidebar a:hover,
      .sidebar a.active {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: white;
      }

      .main-content {
        flex: 1;
        min-width: 0;
      }

      .topbar {
        background: rgba(255,255,255,0.95);
        border-bottom: 1px solid #e2e8f0;
        backdrop-filter: blur(10px);
      }

      .topbar-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
      }

      .topbar-subtitle {
        font-size: 0.88rem;
        color: #64748b;
      }

      .topbar-user {
        min-width: 0;
        text-align: right;
      }

      .topbar-user-email {
        font-weight: 600;
        word-break: break-word;
      }

      .locale-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid #dbe3ef;
        background: white;
        color: #334155;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
      }

      .locale-link.active {
        background: #2563eb;
        border-color: #2563eb;
        color: white;
      }

      .sidebar-toggle,
      .sidebar-close,
      .sidebar-backdrop {
        display: none;
      }

      .sidebar-toggle,
      .sidebar-close {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        border: 1px solid #dbe3ef;
        background: white;
        color: #0f172a;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
      }

      .page-shell {
        padding: 30px;
      }

      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 26px;
        gap: 18px;
      }

      .page-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
      }

      .page-title {
        font-size: 2rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.7px;
      }

      .page-subtitle {
        color: #64748b;
        margin-top: 6px;
        font-size: 1rem;
      }

      .stat-card,
      .content-card,
      .form-card {
        border: none;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        padding: 28px;
        transition: all 0.25s ease;
      }

      .stat-card:hover,
      .content-card:hover,
      .form-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
      }

      .stat-label {
        color: #64748b;
        font-weight: 600;
        margin-bottom: 12px;
        font-size: 1rem;
      }

      .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        color: #0f172a;
      }

      .table-clean {
        margin-bottom: 0;
      }

      .table-clean thead th {
        border-bottom: 1px solid #e2e8f0;
        color: #334155;
        font-size: 0.98rem;
        font-weight: 700;
        padding: 18px 14px;
        background: transparent;
      }

      .table-clean tbody td {
        padding: 18px 14px;
        border-bottom: 1px solid #eef2f7;
        color: #0f172a;
        vertical-align: middle;
      }

      .badge-soft {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .badge-confirmed {
        background: #dcfce7;
        color: #166534;
      }

      .badge-pending {
        background: #fef3c7;
        color: #92400e;
      }

      .badge-completed {
        background: #dbeafe;
        color: #1d4ed8;
      }

      .badge-cancelled {
        background: #fee2e2;
        color: #b91c1c;
      }

      .btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        border: none;
        border-radius: 16px;
        min-height: 52px;
        font-weight: 700;
        padding: 0 22px;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.25);
        transition: all 0.25s ease;
      }

      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.35);
        color: white;
      }

      .btn-danger,
      .btn-warning {
        border-radius: 12px;
      }

      .btn-sm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: all 0.2s ease;
      }

      .btn-sm:hover {
        transform: translateY(-2px);
      }

      .action-btn {
        min-width: 160px;
      }

      .action-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .action-group .button_to {
        margin: 0;
      }

      .action-group .button_to,
      .action-group .btn {
        flex: 0 0 auto;
      }

      .form-label {
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
      }

      .form-control,
      .form-select {
        height: 54px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #f8fafc;
        box-shadow: none !important;
        padding-left: 16px;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: #2563eb;
        background: #fff;
      }

      textarea.form-control {
        min-height: 130px;
        height: auto;
        padding-top: 14px;
      }

      .section-title {
        font-size: 1.65rem;
        font-weight: 800;
        margin-bottom: 22px;
      }

      .empty-state {
        text-align: center;
        padding: 35px 20px;
        color: #64748b;
      }

      .form-errors {
        margin-bottom: 20px;
      }

      .setup-shell {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px 16px 40px;
      }

      .setup-card {
        border: none;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        padding: 28px;
      }

      .responsive-form-card {
        width: 100%;
      }

      .settings-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }

      .settings-grid .full {
        grid-column: 1 / -1;
      }

      .auth-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        background:
          radial-gradient(circle at top left, rgba(37, 99, 235, 0.12), transparent 28%),
          radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.10), transparent 30%),
          #f5f7fb;
      }

      .auth-brand-side {
        background: linear-gradient(135deg, #0b132b 0%, #0f172a 45%, #1d4ed8 100%);
        color: white;
        padding: 44px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .brand-logo {
        font-size: 1.9rem;
        font-weight: 800;
        margin-bottom: 16px;
      }

      .brand-badge {
        display: inline-block;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.12);
        color: #dbeafe;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 0.95rem;
        margin-bottom: 20px;
      }

      .brand-title {
        font-size: 2.5rem;
        line-height: 1.1;
        font-weight: 800;
        max-width: 560px;
        margin-bottom: 16px;
      }

      .brand-text {
        color: rgba(255,255,255,0.82);
        font-size: 1rem;
        line-height: 1.8;
        max-width: 560px;
        margin-bottom: 22px;
      }

      .brand-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        max-width: 620px;
      }

      .feature-box {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 20px;
        padding: 18px;
      }

      .feature-box h6 {
        margin-bottom: 8px;
        font-size: 1rem;
        font-weight: 700;
      }

      .feature-box p {
        margin: 0;
        color: rgba(255,255,255,0.75);
        font-size: 0.95rem;
      }

      .brand-footer {
        color: rgba(255,255,255,0.65);
        font-size: 0.95rem;
        margin-top: 30px;
      }

      .auth-form-side {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
      }

      .auth-panel {
        width: 100%;
        max-width: 460px;
        padding: 32px;
        border-radius: 24px;
        background: white;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
      }

      .auth-logo {
        font-size: 1.55rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
      }

      .auth-subtitle {
        color: #64748b;
        margin-bottom: 22px;
        line-height: 1.7;
      }

      .auth-links a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
      }

      .remember-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 16px 0 22px;
        color: #475569;
      }

      .input-icon-group {
        position: relative;
      }

      .input-icon {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
      }

      .input-with-icon {
        padding-left: 44px !important;
      }

      .password-toggle {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
      }

      .mini-note {
        color: #94a3b8;
        font-size: 0.92rem;
      }

      #appointments-calendar {
        background: white;
        border-radius: 18px;
        padding: 20px;
      }

      .fc-toolbar.fc-header-toolbar {
        margin-bottom: 20px;
      }

      .fc-toolbar-chunk {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .fc .fc-button-group {
        display: flex;
        gap: 8px;
      }

      .fc .fc-button-group > .fc-button {
        margin: 0 !important;
      }

      .fc .fc-toolbar-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0f172a;
      }

      .fc .fc-button {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%) !important;
        border: none !important;
        border-radius: 12px !important;
        padding: 8px 16px !important;
        font-weight: 600 !important;
        box-shadow: 0 6px 14px rgba(37,99,235,0.25);
        transition: all 0.2s ease;
      }

      .fc .fc-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(37,99,235,0.35);
      }

      .fc .fc-button-active {
        background: #1e40af !important;
      }

      .fc .fc-prev-button,
      .fc .fc-next-button {
        width: 40px;
        height: 40px;
        padding: 0 !important;
      }

      .fc .fc-col-header-cell-cushion,
      .fc .fc-daygrid-day-number {
        color: #0f172a;
        text-decoration: none;
        font-weight: 600;
      }

      .fc-daygrid-day {
        transition: background 0.15s ease;
      }

      .fc-daygrid-day:hover {
        background: #f8fbff;
        cursor: pointer;
      }

      .fc .fc-day-today {
        background: #eff6ff !important;
      }

      .fc .fc-day-today .fc-daygrid-day-number {
        background: #2563eb;
        color: white !important;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 6px;
      }

      .fc .fc-event {
        border: none;
        border-radius: 10px;
        padding: 3px 6px;
        font-weight: 600;
        color: white !important;
      }

      .fc-event.confirmed {
        background: #22c55e !important;
      }

      .fc-event.pending {
        background: #f59e0b !important;
      }

      .fc-event.completed {
        background: #2563eb !important;
      }

      .fc-event.cancelled {
        background: #ef4444 !important;
      }

      .fc-theme-standard td,
      .fc-theme-standard th,
      .fc-theme-standard .fc-scrollgrid {
        border-color: #e5e7eb;
      }

      .responsive-table {
        width: 100%;
      }

      .clinic-navbar-logo {
        width: 42px;
        height: 42px;
        object-fit: cover;
        border-radius: 999px;
        border: 2px solid #e5e7eb;
        background: white;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
      }

      .sidebar-logo {
        width: 38px;
        height: 38px;
        object-fit: cover;
        border-radius: 12px;
        background: white;
        padding: 3px;
      }

      .search-box {
        width: 100%;
        max-width: 340px;
      }

      .search-input {
        height: 48px;
        border-radius: 14px;
        border: 1px solid #dbe3ef;
        background: #f8fafc;
        padding: 0 16px;
        width: 100%;
        outline: none;
        transition: all 0.2s ease;
        font-size: 16px;
      }

      .search-input:focus {
        border-color: #2563eb;
        background: white;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
      }

      .btn-outline-primary {
        border-radius: 16px;
        min-height: 52px;
        font-weight: 700;
        padding: 0 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: all 0.25s ease;
      }

      .btn-outline-primary:hover {
        transform: translateY(-3px);
      }

      .btn-outline-secondary {
        border-radius: 12px;
        font-weight: 600;
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }

      .btn-outline-secondary:hover {
        transform: translateY(-2px);
      }

      @media (max-width: 991px) {
        .app-shell {
          display: block;
        }

        .sidebar-backdrop {
          display: block;
          position: fixed;
          inset: 0;
          border: none;
          background: rgba(15, 23, 42, 0.55);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.2s ease;
          z-index: 1030;
        }

        body.sidebar-open .sidebar-backdrop {
          opacity: 1;
          pointer-events: auto;
        }

        .sidebar {
          position: fixed;
          top: 0;
          left: 0;
          bottom: 0;
          width: min(84vw, 320px);
          min-height: 100vh;
          z-index: 1040;
          transform: translateX(-105%);
          transition: transform 0.24s ease;
          box-shadow: 0 18px 40px rgba(15, 23, 42, 0.32);
        }

        body.sidebar-open .sidebar {
          transform: translateX(0);
        }

        .sidebar-close,
        .sidebar-toggle {
          display: inline-flex;
        }

        .sidebar-close {
          margin-left: auto;
          margin-bottom: 18px;
          background: rgba(255,255,255,0.08);
          border-color: rgba(255,255,255,0.12);
          color: white;
        }

        .topbar {
          position: sticky;
          top: 0;
          z-index: 1020;
        }

        .page-shell {
          padding: 22px 16px 32px;
        }

        .page-header {
          flex-direction: column;
          align-items: stretch;
        }

        .page-actions,
        .page-header > .btn,
        .page-header > .btn-outline-primary,
        .page-header > .btn-primary {
          width: 100%;
        }

        .page-actions .btn,
        .page-actions .btn-outline-primary,
        .page-actions .btn-warning {
          width: 100%;
        }

        .action-btn,
        .search-box {
          max-width: none;
          width: 100%;
        }

        .stat-card,
        .content-card,
        .form-card,
        .setup-card,
        .auth-panel {
          padding: 22px;
          border-radius: 20px;
        }

        .auth-shell {
          grid-template-columns: 1fr;
        }

        .auth-brand-side {
          display: none;
        }

        .settings-grid {
          grid-template-columns: 1fr;
        }

        .topbar .d-flex.justify-content-between {
          gap: 14px;
          align-items: flex-start !important;
        }

        #appointments-calendar {
          padding: 14px;
        }

        .fc .fc-toolbar {
          flex-direction: column;
          align-items: stretch;
          gap: 12px;
        }

        .fc-toolbar-chunk {
          justify-content: center;
          flex-wrap: wrap;
        }
      }

      @media (max-width: 767px) {
        .page-title {
          font-size: 1.65rem;
        }

        .page-subtitle,
        .auth-subtitle,
        .brand-text {
          font-size: 0.98rem;
        }

        .section-title {
          font-size: 1.35rem;
        }

        .topbar {
          padding: 14px 16px !important;
        }

        .topbar-title {
          font-size: 1rem;
        }

        .topbar-user {
          text-align: left;
          width: 100%;
        }

        .topbar-user-email {
          font-size: 0.92rem;
        }

        .table-responsive {
          overflow: visible;
        }

        .responsive-table thead {
          display: none;
        }

        .responsive-table,
        .responsive-table tbody,
        .responsive-table tr,
        .responsive-table td {
          display: block;
          width: 100%;
        }

        .responsive-table tbody {
          display: grid;
          gap: 14px;
        }

        .responsive-table tr {
          padding: 18px;
          border: 1px solid #e2e8f0;
          border-radius: 20px;
          background: #fff;
          box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        }

        .responsive-table td {
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          gap: 14px;
          border: none !important;
          padding: 10px 0 !important;
          text-align: right;
        }

        .responsive-table td::before {
          content: attr(data-label);
          color: #475569;
          font-weight: 700;
          text-align: left;
          flex: 0 0 42%;
        }

        .responsive-table td.actions-cell {
          display: block;
          text-align: left;
          padding-top: 14px !important;
        }

        .responsive-table td.actions-cell::before {
          display: block;
          margin-bottom: 10px;
        }

        .responsive-table .action-group {
          width: 100%;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 10px;
        }

        .responsive-table .action-group > * {
          min-width: 0;
        }

        .responsive-table .action-group .btn,
        .responsive-table .action-group .button_to,
        .responsive-table .action-group .button_to .btn {
          width: 100%;
        }

        .responsive-table .badge-soft {
          margin-left: auto;
        }

        .btn,
        .btn-sm,
        .btn-outline-primary,
        .btn-outline-secondary {
          min-height: 46px;
        }

        .form-card .btn-primary,
        .setup-card .btn-primary,
        .auth-panel .btn-primary,
        .form-card .btn-outline-primary {
          width: 100%;
        }

        .auth-form-side {
          padding: 24px 14px;
        }

        .setup-shell {
          padding: 16px 12px 32px;
        }

        .remember-row {
          align-items: flex-start;
        }

        .password-toggle {
          font-size: 0.9rem;
        }
      }

      @media (max-width: 575px) {
        .page-shell {
          padding: 18px 12px 28px;
        }

        .stat-value {
          font-size: 1.9rem;
        }

        .fc .fc-button-group,
        .fc-toolbar-chunk {
          width: 100%;
        }

        .fc .fc-button-group {
          justify-content: center;
          flex-wrap: wrap;
        }

        .fc .fc-button {
          width: 100%;
        }

        .responsive-table .action-group {
          grid-template-columns: 1fr;
        }

        .page-actions {
          gap: 10px;
        }
      }

.floating-chatbot-wrap {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 1060;
}

.floating-chatbot-btn {
  position: relative;
  width: 68px;
  height: 68px;
  border: none;
  border-radius: 999px;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: white;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 18px 34px rgba(37, 99, 235, 0.35);
  cursor: pointer;
  transition: all 0.25s ease;
}

.floating-chatbot-btn:hover {
  transform: translateY(-4px) scale(1.04);
  color: white;
  box-shadow: 0 22px 42px rgba(37, 99, 235, 0.42);
}

.floating-chatbot-btn i {
  font-size: 1.6rem;
}

.floating-chatbot-btn::before {
  content: "";
  position: absolute;
  inset: -6px;
  border-radius: 999px;
  border: 8px solid rgba(59, 130, 246, 0.18);
  animation: chatbotPulse 2s infinite;
}

@keyframes chatbotPulse {
  0% {
    transform: scale(0.92);
    opacity: 0.9;
  }
  70% {
    transform: scale(1.12);
    opacity: 0;
  }
  100% {
    transform: scale(1.12);
    opacity: 0;
  }
}

.chatbot-ai-badge {
  position: absolute;
  top: -6px;
  right: -4px;
  background: #0f172a;
  color: #fff;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.4px;
  padding: 4px 7px;
  border-radius: 999px;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.22);
}

.chatbot-tooltip {
  position: absolute;
  right: 78px;
  bottom: 50%;
  transform: translateY(50%);
  background: #0f172a;
  color: white;
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 0.92rem;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.22);
  opacity: 0;
  pointer-events: none;
  transition: all 0.2s ease;
}

.chatbot-tooltip::after {
  content: "";
  position: absolute;
  top: 50%;
  right: -6px;
  width: 12px;
  height: 12px;
  background: #0f172a;
  transform: translateY(-50%) rotate(45deg);
}

.floating-chatbot-wrap:hover .chatbot-tooltip {
  opacity: 1;
  transform: translateY(50%) translateX(-4px);
}

.chatbot-popup {
  position: absolute;
  right: 0;
  bottom: 88px;
  width: 380px;
  max-width: calc(100vw - 24px);
  height: 600px;
  background: #ffffff;
  border-radius: 24px;
  box-shadow: 0 26px 70px rgba(15, 23, 42, 0.22);
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateY(16px) scale(0.98);
  transition: all 0.25s ease;
  border: 1px solid #e2e8f0;
}

.chatbot-popup.open {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}

.chatbot-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
  color: white;
}

.chatbot-popup-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chatbot-popup-icon {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: rgba(255,255,255,0.14);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.chatbot-popup-title {
  font-weight: 800;
  font-size: 1rem;
  margin: 0;
}

.chatbot-popup-subtitle {
  font-size: 0.82rem;
  opacity: 0.82;
  margin: 2px 0 0;
}

.chatbot-popup-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.chatbot-popup-action-btn {
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 12px;
  background: rgba(255,255,255,0.14);
  color: white;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: all 0.2s ease;
}

.chatbot-popup-action-btn:hover {
  background: rgba(255,255,255,0.22);
  color: white;
  transform: translateY(-2px);
}

.chatbot-popup-frame {
  width: 100%;
  height: calc(100% - 74px);
  border: 0;
  background: white;
}

@media (max-width: 767px) {
  .floating-chatbot-wrap {
    right: 16px;
    bottom: 16px;
  }

  .floating-chatbot-btn {
    width: 60px;
    height: 60px;
  }

  .chatbot-popup {
    position: fixed;
    right: 12px;
    left: 12px;
    bottom: 88px;
    width: auto;
    max-width: none;
    height: 72vh;
    border-radius: 22px;
  }

  .chatbot-tooltip {
    display: none;
  }
}
.auth-form__group {
  margin-bottom: 1rem;
}

.auth-form__label {
  display: block;
  margin-bottom: 0.45rem;
  font-weight: 600;
  color: #0f172a;
}

.auth-form__hint {
  margin: -0.15rem 0 0.5rem;
  font-size: 0.9rem;
  color: #64748b;
}

.auth-form__input {
  width: 100%;
  height: 48px;
  padding: 0 14px;
  border: 1px solid #dbe3f0;
  border-radius: 12px;
  background: #fff;
  font-size: 1rem;
  box-sizing: border-box;
}

.auth-form__input:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
}

.auth-form__actions {
  margin-top: 1rem;
}

.auth-form__submit {
  width: 100%;
  height: 48px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: white;
  font-weight: 700;
  cursor: pointer;
}

.auth-card__links {
  margin-top: 1rem;
}

.auth-card__links a {
  color: #2563eb;
  text-decoration: none;
  font-weight: 600;
}

.auth-card__links a:hover {
  text-decoration: underline;
}
    </style>
