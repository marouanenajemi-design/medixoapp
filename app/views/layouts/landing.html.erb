<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title>MedixoApp — <%= t("landing.hero.headline").truncate(60) %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= t("landing.hero.subheadline").truncate(160) %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
</head>
<body class="landing-body">

<%# ── NAV ── %>
<nav class="l-nav" id="lNav">
  <div class="lc l-nav-inner">
    <%= link_to root_path, class: "l-nav-brand" do %>
      <div class="l-nav-brand-mark"><i class="bi bi-heart-pulse-fill"></i></div>
      <span class="l-nav-brand-name">MedixoApp</span>
    <% end %>

    <div class="l-nav-links">
      <a href="#features" data-turbo="false"><%= t("landing.nav.features") %></a>
      <a href="#pricing" data-turbo="false"><%= t("landing.nav.pricing") %></a>
      <a href="#faq" data-turbo="false"><%= t("landing.nav.faq") %></a>
    </div>

    <div class="l-nav-ctas ms-auto">
      <div class="l-locale me-2">
        <% I18n.available_locales.each do |locale| %>
          <%= link_to locale.to_s.upcase, url_for(locale: locale),
                class: "#{I18n.locale == locale ? 'active' : ''}" %>
        <% end %>
      </div>
      <%= link_to t("landing.nav.login"), new_user_session_path, class: "l-nav-login" %>
      <%= link_to t("landing.nav.signup"), new_user_registration_path, class: "l-btn l-btn-sm l-btn-primary" %>
    </div>
  </div>
</nav>

<main>
  <%= yield %>
</main>

<%# ── FOOTER ── %>
<footer class="l-footer">
  <div class="lc">
    <div class="l-footer-grid">
      <div>
        <div class="d-flex align-items-center gap-2">
          <div class="l-nav-brand-mark"><i class="bi bi-heart-pulse-fill"></i></div>
          <div class="l-footer-brand-name">MedixoApp</div>
        </div>
        <p class="l-footer-tagline"><%= t("landing.footer.tagline") %></p>
      </div>
      <div>
        <div class="l-footer-col-title"><%= t("landing.footer.product") %></div>
        <ul class="l-footer-col-links">
          <li><a href="#features" data-turbo="false"><%= t("landing.footer.link_features") %></a></li>
          <li><a href="#pricing" data-turbo="false"><%= t("landing.footer.link_pricing") %></a></li>
          <li><a href="#faq" data-turbo="false"><%= t("landing.footer.link_faq") %></a></li>
        </ul>
      </div>
      <div>
        <div class="l-footer-col-title"><%= t("landing.footer.company") %></div>
        <ul class="l-footer-col-links">
          <li><%= link_to t("landing.footer.link_login"), new_user_session_path %></li>
          <li><%= link_to t("landing.footer.link_signup"), new_user_registration_path %></li>
          <li><%= link_to t("landing.nav.pricing"), pricing_path %></li>
        </ul>
      </div>
    </div>

    <div class="l-footer-bottom">
      <span class="l-footer-copy">&copy; <%= Date.current.year %> <%= t("landing.footer.copyright") %></span>
      <div class="l-footer-locale">
        <% I18n.available_locales.each do |locale| %>
          <%= link_to locale.to_s.upcase, url_for(locale: locale),
                class: "#{I18n.locale == locale ? 'active' : ''}" %>
        <% end %>
      </div>
    </div>
  </div>
</footer>

<script>
  // ── Nav scroll shadow ──
  // Guard prevents a duplicate listener when Turbo replaces the body (e.g. locale switch).
  // Handler reads #lNav fresh each call so it targets the current DOM element.
  if (!window._lScrollBound) {
    window._lScrollBound = true;
    window.addEventListener("scroll", () => {
      const n = document.getElementById("lNav");
      if (n) n.classList.toggle("scrolled", window.scrollY > 20);
    }, { passive: true });
  }

  // ── Anchor scroll ──
  // Problem: Turbo intercepts hash links and won't re-scroll on repeated clicks to
  // the same anchor (URL hash already matches, so Turbo considers it a no-op).
  // Native browsers have the same freeze.
  // Fix: intercept ALL hash clicks via event delegation, prevent default, scroll
  // explicitly with nav offset, update URL without navigation via replaceState.
  // data-turbo="false" on hash links removes Turbo's interception as a first line of
  // defence; this JS handles the native same-hash case and provides the nav offset.
  // Guard prevents duplicate document listeners across Turbo body-swaps.
  if (!window._lAnchorBound) {
    window._lAnchorBound = true;
    document.addEventListener("click", function(e) {
      const link = e.target.closest('a[href^="#"]');
      if (!link) return;
      const hash = link.getAttribute("href");
      if (!hash || hash === "#") return;
      const target = document.querySelector(hash);
      if (!target) return;
      e.preventDefault();
      const navH = (document.getElementById("lNav")?.offsetHeight ?? 66) + 8;
      const top  = target.getBoundingClientRect().top + window.scrollY - navH;
      window.scrollTo({ top, behavior: "smooth" });
      history.replaceState(null, "", hash);
    });
  }

  // ── FAQ accordion ──
  // Event delegation — guard prevents duplicate listener on body-swap.
  if (!window._lFaqBound) {
    window._lFaqBound = true;
    document.addEventListener("click", function(e) {
      const btn = e.target.closest(".l-faq-btn");
      if (!btn) return;
      const item = btn.closest(".l-faq-item");
      const isOpen = item.classList.contains("open");
      document.querySelectorAll(".l-faq-item.open").forEach(i => i.classList.remove("open"));
      if (!isOpen) item.classList.add("open");
    });
  }

  // ── Scroll-in animations ──
  // No guard: runs on each body-swap to observe the fresh DOM elements.
  (function() {
    const io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add("anim-fade-up"); io.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".l-feat-card, .l-flow-card, .l-plan-card, .l-faq-item")
            .forEach(function(el) { io.observe(el); });
  })();
</script>
</body>
</html>
