<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:page_title) ? yield(:page_title) : t("bookings.layout.title") %> — MedixoApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-visit-control" content="reload">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag "booking", "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body class="booking-body">
    <div class="booking-top-bar">
      <div class="booking-top-inner">
        <a href="/" class="booking-brand">
          <div class="booking-brand-mark"><i class="bi bi-heart-pulse-fill"></i></div>
          <span class="booking-brand-name">MedixoApp</span>
        </a>

        <div class="d-flex gap-2">
          <% I18n.available_locales.each do |locale| %>
            <%= link_to locale.to_s.upcase,
                  url_for(locale: locale),
                  class: "booking-locale-btn #{'active' if I18n.locale == locale}" %>
          <% end %>
        </div>
      </div>
    </div>

    <% if notice %>
      <div class="booking-alert booking-alert--success"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="booking-alert booking-alert--danger"><%= alert %></div>
    <% end %>

    <main class="booking-main">
      <%= yield %>
    </main>

    <footer class="booking-footer">
      <div class="booking-footer-inner">
        <span>Powered by</span>
        <a href="/" class="booking-footer-brand">
          <i class="bi bi-heart-pulse-fill"></i> MedixoApp
        </a>
        <span class="booking-footer-sep">·</span>
        <span><%= t("bookings.layout.footer_tagline") %></span>
      </div>
    </footer>
  </body>
</html>
