<div class="page-shell">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("appointments.index.title") %></h1>
      <div class="page-subtitle"><%= t("appointments.index.subtitle") %></div>
    </div>
    <div class="page-actions d-flex gap-2 flex-wrap">
      <%= link_to clinic_booking_path(current_clinic.slug),
            class: "btn btn-sm btn-outline-secondary",
            target: "_blank",
            title: t("appointments.index.share_booking_link") do %>
        <i class="bi bi-link-45deg"></i> <%= t("appointments.index.booking_page") %>
      <% end %>
      <%= link_to t("shared.actions.new_appointment"), new_appointment_path, class: "btn btn-primary action-btn" %>
    </div>
  </div>

  <%# ── Online booking requests (pending only) ── %>
  <% if @online_pending.any? %>
    <div class="content-card mb-4" style="border-left:4px solid #14b8a6;">
      <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <h2 class="section-title mb-0" style="font-size:1.1rem;">
          <i class="bi bi-globe2 me-1" style="color:#14b8a6;"></i>
          <%= t("appointments.index.online_requests") %>
        </h2>
        <span class="badge-soft badge-pending"><%= @online_pending.count %> <%= t("appointments.index.pending") %></span>
      </div>

      <div class="table-responsive">
        <table class="table table-clean responsive-table">
          <thead>
            <tr>
              <th><%= t("shared.tables.patient") %></th>
              <th><%= t("shared.tables.doctor") %></th>
              <th><%= t("shared.tables.date") %></th>
              <th><%= t("shared.tables.time") %></th>
              <th><%= t("appointments.index.reason") %></th>
              <th><%= t("shared.tables.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @online_pending.each do |appt| %>
              <tr>
                <td data-label="<%= t("shared.tables.patient") %>">
                  <div class="fw-semibold"><%= appt.patient.name %></div>
                  <% if appt.patient_email.present? %>
                    <div style="font-size:0.78rem;color:#64748b;"><%= appt.patient_email %></div>
                  <% end %>
                </td>
                <td data-label="<%= t("shared.tables.doctor") %>"><%= appt.doctor.name %></td>
                <td data-label="<%= t("shared.tables.date") %>"><%= appt.appointment_date.strftime("%b %d, %Y") %></td>
                <td data-label="<%= t("shared.tables.time") %>"><%= formatted_time(appt.appointment_time) %></td>
                <td data-label="<%= t("appointments.index.reason") %>">
                  <span style="font-size:0.85rem;color:#64748b;"><%= appt.notes.presence || "—" %></span>
                </td>
                <td class="actions-cell" data-label="<%= t("shared.tables.actions") %>">
                  <div class="action-group">
                    <%= button_to t("appointments.index.approve"), approve_appointment_path(appt),
                          method: :patch,
                          class: "btn btn-sm btn-success" %>
                    <%= button_to t("appointments.index.reject"), reject_appointment_path(appt),
                          method: :patch,
                          class: "btn btn-sm btn-danger",
                          data: { turbo_confirm: t("appointments.index.confirm_reject") } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── All appointments ── %>
  <div class="content-card" data-controller="filter-list">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <h2 class="section-title mb-0"><%= t("appointments.index.list_title") %></h2>
      <div class="search-box">
        <input type="text" class="search-input"
               placeholder="<%= t("appointments.index.search_placeholder") %>"
               data-filter-list-target="input"
               data-action="input->filter-list#filter">
      </div>
    </div>

    <% if @appointments.any? %>
      <div class="table-responsive">
        <table class="table table-clean responsive-table">
          <thead>
            <tr>
              <th><%= t("shared.tables.patient") %></th>
              <th><%= t("shared.tables.doctor") %></th>
              <th><%= t("shared.tables.date") %></th>
              <th><%= t("shared.tables.time") %></th>
              <th><%= t("shared.tables.status") %></th>
              <th><%= t("shared.tables.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @appointments.each do |appointment| %>
              <% badge_class = case appointment.status
                               when "confirmed" then "badge-confirmed"
                               when "pending"   then "badge-pending"
                               when "completed" then "badge-completed"
                               when "cancelled" then "badge-cancelled"
                               else "badge-completed"
                               end %>
              <tr data-filter-list-target="row"
                  data-filter-list-searchable-value="<%= [appointment.patient.name, appointment.doctor.name, appointment_status_label(appointment.status), appointment.appointment_date].join(' ').downcase %>">
                <td class="fw-semibold" data-label="<%= t("shared.tables.patient") %>">
                  <%= appointment.patient.name %>
                  <% if appointment.online? %>
                    <span style="display:inline-flex;align-items:center;gap:3px;font-size:0.7rem;font-weight:700;background:rgba(20,184,166,0.1);color:#0d9488;padding:2px 7px;border-radius:999px;margin-left:5px;">
                      <i class="bi bi-globe2"></i> Online
                    </span>
                  <% end %>
                </td>
                <td data-label="<%= t("shared.tables.doctor") %>"><%= appointment.doctor.name %></td>
                <td data-label="<%= t("shared.tables.date") %>"><%= appointment.appointment_date %></td>
                <td data-label="<%= t("shared.tables.time") %>"><%= formatted_time(appointment.appointment_time) %></td>
                <td data-label="<%= t("shared.tables.status") %>">
                  <span class="badge-soft <%= badge_class %>"><%= appointment_status_label(appointment.status) %></span>
                </td>
                <td class="actions-cell" data-label="<%= t("shared.tables.actions") %>">
                  <div class="action-group">
                    <%= link_to t("shared.actions.edit"), edit_appointment_path(appointment), class: "btn btn-sm btn-warning" %>
                    <%= button_to t("shared.actions.delete"), appointment_path(appointment),
                          method: :delete,
                          class: "btn btn-sm btn-danger",
                          data: { turbo_confirm: t("shared.confirmations.delete") } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="empty-state" style="display:none;" data-filter-list-target="empty">
        <%= t("appointments.index.search_empty") %>
      </div>
    <% else %>
      <div class="empty-state"><%= t("appointments.index.empty") %></div>
    <% end %>
  </div>
</div>
