<div class="page-shell">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("admin.dashboard.title") %></h1>
      <div class="page-subtitle"><%= t("admin.dashboard.subtitle") %></div>
    </div>
  </div>

  <%# ── Platform stats row 1 ── %>
  <div class="row g-4 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-people me-1"></i> <%= t("admin.dashboard.stats.users") %></div>
        <div class="stat-value"><%= @total_users %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-hospital me-1"></i> <%= t("admin.dashboard.stats.clinics") %></div>
        <div class="stat-value"><%= @total_clinics %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-person-badge me-1"></i> <%= t("admin.dashboard.stats.doctors") %></div>
        <div class="stat-value"><%= @total_doctors %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-heart-pulse me-1"></i> <%= t("admin.dashboard.stats.patients") %></div>
        <div class="stat-value"><%= @total_patients %></div>
      </div>
    </div>
  </div>

  <%# ── Subscription stats row 2 ── %>
  <div class="row g-4 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-check-circle me-1 text-success"></i> <%= t("admin.dashboard.stats.subscribed") %></div>
        <div class="stat-value text-success"><%= @subscribed_clinics %></div>
        <div class="stat-sub"><%= t("admin.dashboard.stats.active_subscriptions") %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-hourglass-split me-1 text-warning"></i> <%= t("admin.dashboard.stats.trialing") %></div>
        <div class="stat-value text-warning"><%= @trialing_clinics %></div>
        <div class="stat-sub"><%= t("admin.dashboard.stats.on_trial") %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-x-circle me-1 text-danger"></i> <%= t("admin.dashboard.stats.expired") %></div>
        <div class="stat-value text-danger"><%= @expired_clinics %></div>
        <div class="stat-sub"><%= t("admin.dashboard.stats.no_access") %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card h-100">
        <div class="stat-label"><i class="bi bi-calendar-check me-1"></i> <%= t("admin.dashboard.stats.appointments") %></div>
        <div class="stat-value"><%= @total_appointments %></div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <%# ── Recent signups ── %>
    <div class="col-12 col-xl-6">
      <div class="content-card h-100">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="section-title mb-0"><%= t("admin.dashboard.recent_users") %></h2>
          <%= link_to t("admin.dashboard.view_all"), admin_users_path, class: "btn-outline-secondary btn btn-sm" %>
        </div>

        <% if @recent_users.any? %>
          <div class="table-responsive">
            <table class="table table-clean responsive-table">
              <thead>
                <tr>
                  <th><%= t("admin.tables.email") %></th>
                  <th><%= t("admin.tables.clinic") %></th>
                  <th><%= t("admin.tables.role") %></th>
                  <th><%= t("admin.tables.joined") %></th>
                </tr>
              </thead>
              <tbody>
                <% @recent_users.each do |user| %>
                  <tr>
                    <td data-label="<%= t("admin.tables.email") %>">
                      <%= link_to user.email, admin_user_path(user), class: "fw-semibold text-decoration-none" %>
                    </td>
                    <td data-label="<%= t("admin.tables.clinic") %>">
                      <% if user.clinic %>
                        <%= link_to user.clinic.name, admin_clinic_path(user.clinic), class: "text-decoration-none" %>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td data-label="<%= t("admin.tables.role") %>">
                      <% if user.super_admin? %>
                        <span class="badge-soft badge-admin"><%= t("admin.roles.super_admin") %></span>
                      <% else %>
                        <span class="badge-soft badge-user"><%= t("admin.roles.user") %></span>
                      <% end %>
                    </td>
                    <td data-label="<%= t("admin.tables.joined") %>">
                      <%= user.created_at.strftime("%b %d, %Y") %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty-state"><%= t("admin.dashboard.no_users") %></div>
        <% end %>
      </div>
    </div>

    <%# ── Recent clinics ── %>
    <div class="col-12 col-xl-6">
      <div class="content-card h-100">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="section-title mb-0"><%= t("admin.dashboard.recent_clinics") %></h2>
          <%= link_to t("admin.dashboard.view_all"), admin_clinics_path, class: "btn-outline-secondary btn btn-sm" %>
        </div>

        <% if @recent_clinics.any? %>
          <div class="table-responsive">
            <table class="table table-clean responsive-table">
              <thead>
                <tr>
                  <th><%= t("admin.tables.clinic") %></th>
                  <th><%= t("admin.tables.owner") %></th>
                  <th><%= t("admin.tables.status") %></th>
                </tr>
              </thead>
              <tbody>
                <% @recent_clinics.each do |clinic| %>
                  <tr>
                    <td data-label="<%= t("admin.tables.clinic") %>">
                      <%= link_to clinic.name, admin_clinic_path(clinic), class: "fw-semibold text-decoration-none" %>
                    </td>
                    <td data-label="<%= t("admin.tables.owner") %>">
                      <%= clinic.user.email %>
                    </td>
                    <td data-label="<%= t("admin.tables.status") %>">
                      <%= render "admin/shared/clinic_status_badge", clinic: clinic %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty-state"><%= t("admin.dashboard.no_clinics") %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
