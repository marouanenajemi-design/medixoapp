<div class="page-shell">
  <div class="page-header">
    <div>
      <div class="text-muted small mb-1">
        <%= link_to t("admin.navigation.clinics"), admin_clinics_path, class: "text-decoration-none text-muted" %>
        <i class="bi bi-chevron-right mx-1" style="font-size:0.7rem;"></i>
        <%= @clinic.name %>
      </div>
      <h1 class="page-title"><%= @clinic.name %></h1>
      <div class="d-flex align-items-center gap-2 mt-1">
        <%= render "admin/shared/clinic_status_badge", clinic: @clinic %>
        <span class="text-muted small"><%= t("admin.clinics.show.created", date: @clinic.created_at.strftime("%B %d, %Y")) %></span>
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <%= button_to(
            @clinic.subscribed? ? t("admin.actions.deactivate") : t("admin.actions.activate"),
            toggle_subscription_admin_clinic_path(@clinic),
            method: :patch,
            class: "btn btn-sm #{@clinic.subscribed? ? 'btn-warning' : 'btn-success'}",
            data: { turbo_confirm: t("admin.confirmations.toggle_subscription") }
          ) %>
      <%= button_to t("admin.actions.extend_trial"), extend_trial_admin_clinic_path(@clinic),
            method: :patch,
            class: "btn btn-sm btn-outline-secondary",
            data: { turbo_confirm: t("admin.confirmations.extend_trial") } %>
      <%= button_to t("admin.actions.delete"), admin_clinic_path(@clinic),
            method: :delete,
            class: "btn btn-sm btn-danger",
            data: { turbo_confirm: t("admin.confirmations.delete_clinic") } %>
    </div>
  </div>

  <div class="row g-4">
    <%# ── Clinic details ── %>
    <div class="col-12 col-lg-6">
      <div class="content-card h-100">
        <h2 class="section-title"><%= t("admin.clinics.show.details") %></h2>
        <div class="detail-grid">
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.tables.clinic") %></div>
            <div class="detail-value"><%= @clinic.name %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.tables.phone") %></div>
            <div class="detail-value"><%= @clinic.phone %></div>
          </div>
          <div class="detail-item" style="grid-column: 1 / -1;">
            <div class="detail-label"><%= t("admin.clinics.show.address") %></div>
            <div class="detail-value"><%= @clinic.address %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.tables.owner") %></div>
            <div class="detail-value">
              <%= link_to @clinic.user.email, admin_user_path(@clinic.user), class: "text-decoration-none" %>
            </div>
          </div>
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.tables.plan") %></div>
            <div class="detail-value">
              <span class="admin-plan-badge admin-plan-badge--<%= @clinic.plan_tier %>">
                <%= @clinic.plan_name %>
              </span>
              <span class="text-muted ms-2" style="font-size:0.85rem;">
                €<%= PlanGating::PLANS[@clinic.plan_tier][:price] %>/mo
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# ── Subscription & stats ── %>
    <div class="col-12 col-lg-6">
      <div class="content-card h-100">
        <h2 class="section-title"><%= t("admin.clinics.show.subscription") %></h2>
        <div class="detail-grid mb-4">
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.tables.status") %></div>
            <div class="detail-value"><%= render "admin/shared/clinic_status_badge", clinic: @clinic %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.clinics.show.trial_ends") %></div>
            <div class="detail-value"><%= @clinic.trial_ends_at&.strftime("%b %d, %Y") || "—" %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.clinics.show.billing_customer") %></div>
            <div class="detail-value" style="font-size:0.9rem;word-break:break-all;"><%= @clinic.billing_customer_id.presence || "—" %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label"><%= t("admin.clinics.show.billing_subscription") %></div>
            <div class="detail-value" style="font-size:0.9rem;word-break:break-all;"><%= @clinic.billing_subscription_id.presence || "—" %></div>
          </div>
        </div>

        <h2 class="section-title" style="font-size:1.2rem;"><%= t("admin.clinics.show.usage") %></h2>
        <div class="row g-3">
          <div class="col-4">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.clinics.show.doctors_count") %></div>
              <div class="detail-value" style="font-size:1.8rem;"><%= @doctors_count %></div>
            </div>
          </div>
          <div class="col-4">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.clinics.show.patients_count") %></div>
              <div class="detail-value" style="font-size:1.8rem;"><%= @patients_count %></div>
            </div>
          </div>
          <div class="col-4">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.clinics.show.appointments_count") %></div>
              <div class="detail-value" style="font-size:1.8rem;"><%= @appointments_count %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%# ── Visit billing (usage-based monetization) ── %>
    <div class="col-12">
      <div class="content-card">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
          <div>
            <h2 class="section-title mb-1"><%= t("admin.monetization.clinic_card.title") %></h2>
            <div class="text-muted" style="font-size:0.9rem;">
              <%= t("admin.monetization.clinic_card.subtitle") %>
            </div>
          </div>
          <%= link_to admin_monetization_path, class: "btn btn-sm btn-outline-secondary", data: { turbo: false } do %>
            <i class="bi bi-cash-coin me-1"></i> <%= t("admin.navigation.monetization") %>
          <% end %>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-6 col-lg-3">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.monetization.clinic_card.period_visits") %></div>
              <div class="detail-value" style="font-size:1.8rem;"><%= @billing_summary[:period_visits] %></div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.monetization.clinic_card.total_visits") %></div>
              <div class="detail-value" style="font-size:1.8rem;"><%= @billing_summary[:total_visits] %></div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.monetization.clinic_card.price") %></div>
              <div class="detail-value" style="font-size:1.8rem;">
                <%= money(@billing_summary[:price_per_visit_cents], @billing_summary[:currency]) %>
              </div>
              <div style="font-size:0.75rem;color:#64748b;">
                <%= @billing_summary[:custom_price] ? t("admin.monetization.clinic_card.custom") : t("admin.monetization.clinic_card.global") %>
              </div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="detail-item text-center">
              <div class="detail-label"><%= t("admin.monetization.clinic_card.period_amount") %></div>
              <div class="detail-value" style="font-size:1.8rem;">
                <%= money(@billing_summary[:period_amount_cents], @billing_summary[:currency]) %>
              </div>
              <div style="font-size:0.75rem;color:#64748b;">
                <%= t("admin.monetization.clinic_card.total_amount") %>:
                <%= money(@billing_summary[:total_amount_cents], @billing_summary[:currency]) %>
              </div>
            </div>
          </div>
        </div>

        <%= form_with url: update_visit_price_admin_clinic_path(@clinic), method: :patch,
                      class: "d-flex align-items-end gap-3 flex-wrap", data: { turbo: false } do %>
          <div style="flex:1;min-width:220px;">
            <label class="form-label fw-bold text-muted"
                   style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">
              <%= t("admin.monetization.clinic_card.override_label") %>
            </label>
            <div class="input-group">
              <span class="input-group-text"><%= BillingSetting.symbol_for(@billing_summary[:currency]) %></span>
              <input type="text" name="price_per_visit" inputmode="decimal" class="form-control"
                     value="<%= @clinic.custom_price_per_visit? ? format('%.2f', @clinic.effective_price_per_visit) : '' %>"
                     placeholder="<%= format('%.2f', @billing_setting.price_per_visit) %>">
            </div>
            <div class="form-text"><%= t("admin.monetization.clinic_card.override_hint") %></div>
          </div>
          <button type="submit" class="btn btn-primary" style="white-space:nowrap;min-height:48px;">
            <i class="bi bi-check-lg me-1"></i> <%= t("admin.monetization.clinic_card.override_submit") %>
          </button>
          <% if @clinic.custom_price_per_visit? %>
            <button type="submit" name="reset" value="1" class="btn btn-outline-secondary"
                    style="white-space:nowrap;min-height:48px;">
              <%= t("admin.monetization.clinic_card.override_reset") %>
            </button>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# ── Plan management ── %>
    <div class="col-12">
      <div class="content-card">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
          <div>
            <h2 class="section-title mb-1"><%= t("admin.clinics.plan_tier.management_title") %></h2>
            <div class="text-muted" style="font-size:0.9rem;"><%= t("admin.clinics.plan_tier.management_subtitle") %></div>
          </div>
          <span class="admin-plan-badge admin-plan-badge--<%= @clinic.plan_tier %> admin-plan-badge--lg">
            <i class="bi bi-<%= @clinic.plan_tier == 'clinic_plus' ? 'gem' : @clinic.plan_tier == 'pro' ? 'star-fill' : 'lightning' %>"></i>
            <%= @clinic.plan_name %> Plan
          </span>
        </div>

        <%= form_with url: update_plan_admin_clinic_path(@clinic), method: :patch,
                      class: "d-flex align-items-end gap-3 flex-wrap mb-4" do |f| %>
          <div style="flex:1;min-width:220px;">
            <label class="form-label fw-bold text-muted"
                   style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">
              <%= t("admin.clinics.plan_tier.label") %>
            </label>
            <select name="plan_tier" class="form-select plan-tier-select">
              <% PlanGating::PLANS.each do |tier, config| %>
                <option value="<%= tier %>" <%= "selected" if @clinic.plan_tier == tier %>>
                  <%= config[:name] %> — €<%= config[:price] %>/mo
                </option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="white-space:nowrap;min-height:48px;">
            <i class="bi bi-check-lg me-1"></i>
            <%= t("admin.clinics.plan_tier.update_button") %>
          </button>
        <% end %>

        <div class="plan-compare-grid">
          <% PlanGating::PLANS.each do |tier, config| %>
            <div class="plan-compare-item <%= 'plan-compare-item--active' if @clinic.plan_tier == tier %>">
              <div class="plan-compare-header">
                <span class="admin-plan-badge admin-plan-badge--<%= tier %>"><%= config[:name] %></span>
                <span class="plan-compare-price">€<%= config[:price] %>/mo</span>
              </div>
              <div class="plan-compare-limits">
                <div class="plan-compare-limit">
                  <i class="bi bi-person-badge"></i>
                  <%= config[:doctor_limit] ? "#{config[:doctor_limit]} doctors" : "Unlimited doctors" %>
                </div>
                <div class="plan-compare-limit">
                  <i class="bi bi-people"></i>
                  <%= config[:patient_limit] ? "#{config[:patient_limit]} patients" : "Unlimited patients" %>
                </div>
                <div class="plan-compare-limit <%= config[:features].include?('analytics') ? 'limit-yes' : 'limit-no' %>">
                  <i class="bi bi-bar-chart-line"></i>
                  Analytics <%= config[:features].include?('analytics') ? '✓' : '✗' %>
                </div>
                <% if config[:features].include?('api') %>
                  <div class="plan-compare-limit limit-yes">
                    <i class="bi bi-code-slash"></i> API access ✓
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
