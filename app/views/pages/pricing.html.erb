
<div class="page-shell">
  <div class="page-header">
    <div>
      <h1 class="page-title">MedixoApp Subscription</h1>
      <div class="page-subtitle">
        <% if current_user&.clinic&.trialing? %>
          Your free trial is active. <strong><%= current_user.clinic.trial_days_left %> day(s)</strong> left.
        <% else %>
          Your free trial has ended. Subscribe to continue using MedixoApp.
        <% end %>
      </div>
    </div>
  </div>

  <div class="content-card" style="max-width: 760px; margin: 0 auto;">
    <div class="text-center mb-4">
      <div style="display:inline-block;background:#ccfbf1;color:#0d9488;padding:8px 18px;border-radius:999px;font-weight:700;font-size:0.9rem;letter-spacing:0.3px;">
        All-Inclusive Medical Plan
      </div>
    </div>

    <h2 class="fw-bold mb-2 text-center" style="font-size:2rem;letter-spacing:-0.5px;">MedixoApp Monthly</h2>

    <div class="text-center mb-3" style="font-size: 2.8rem; font-weight: 800; color: #0f172a;">
      €29<span style="font-size: 1rem; color: #64748b; font-weight: 500;"> / month</span>
    </div>

    <p class="text-muted text-center mb-4" style="max-width:500px;margin-left:auto;margin-right:auto;">
      One complete plan for medical clinics — doctors, patients, appointments,
      prescriptions, history, and full practice management in one premium platform.
    </p>

    <div class="row mb-4">
      <div class="col-md-10 mx-auto">
        <div class="row g-2">
          <% [
            "Unlimited doctors & specialists",
            "Unlimited patient records",
            "Appointment calendar & scheduling",
            "Digital prescription management",
            "Full patient history & notes",
            "Clinic branding & settings",
            "AI medicine information assistant",
            "Secure login & data protection",
            "7-day free trial included"
          ].each do |feature| %>
            <div class="col-12 col-sm-6">
              <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;">
                <span style="color:#14b8a6;font-size:1rem;">&#10003;</span>
                <span style="font-size:0.92rem;font-weight:600;color:#334155;"><%= feature %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%= link_to "Subscribe Now — €29/month",
          "https://clinicflow-saas.lemonsqueezy.com/checkout/buy/508d92eb-5487-4a44-925d-75a4ecf204a4",
          class: "btn btn-primary w-100",
          target: "_blank",
          rel: "noopener" %>

    <div class="mt-4 text-center text-muted" style="font-size: 0.9rem;">
      Cancel anytime. Secure checkout powered by Lemon Squeezy.
    </div>
  </div>
</div>
