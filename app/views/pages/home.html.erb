<%# ═══════════════════════════════════════════
    HERO
═══════════════════════════════════════════ %>
<section class="l-hero">
  <div class="lc">
    <div class="l-hero-grid">

      <%# ── Left: copy ── %>
      <div>
        <div class="l-hero-badge">
          <%= t("landing.hero.badge") %>
        </div>
        <h1 class="anim-fade-up">
          <%= t("landing.hero.headline").gsub("modern", "<span class='hl'>modern</span>").html_safe %>
        </h1>
        <p class="l-hero-sub anim-fade-up anim-delay-1">
          <%= t("landing.hero.subheadline") %>
        </p>
        <div class="l-hero-ctas anim-fade-up anim-delay-2">
          <%= link_to t("landing.hero.cta_primary"), new_user_registration_path,
                class: "l-btn l-btn-md l-btn-primary" %>
          <a href="#features" class="l-btn l-btn-md l-btn-ghost-white">
            <i class="bi bi-play-circle"></i>
            <%= t("landing.hero.cta_secondary") %>
          </a>
        </div>
        <div class="l-hero-trust anim-fade-up anim-delay-3">
          <span><%= t("landing.hero.trust_trial") %></span>
          <span><%= t("landing.hero.trust_card") %></span>
          <span><%= t("landing.hero.trust_setup") %></span>
        </div>
      </div>

      <%# ── Right: dashboard mockup ── %>
      <div class="l-mockup-wrap anim-fade-up anim-delay-2">
        <div class="l-mockup-glow"></div>
        <div class="l-mockup">
          <%# Browser chrome %>
          <div class="l-mockup-bar">
            <div class="l-mockup-dot"></div>
            <div class="l-mockup-dot"></div>
            <div class="l-mockup-dot"></div>
            <div class="l-mockup-url">app.medixoapp.com/dashboard</div>
          </div>
          <div class="l-mockup-body">
            <%# Sidebar %>
            <div class="l-mockup-sidebar">
              <div class="l-mockup-brand">
                <div class="l-mockup-brand-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                <div class="l-mockup-brand-name">MedixoApp</div>
              </div>
              <div class="l-mockup-nav-item active">
                <span class="l-mockup-nav-icon">⚡</span> Dashboard
              </div>
              <div class="l-mockup-nav-item">
                <span class="l-mockup-nav-icon">👤</span> Doctors
              </div>
              <div class="l-mockup-nav-item">
                <span class="l-mockup-nav-icon">👥</span> Patients
              </div>
              <div class="l-mockup-nav-item">
                <span class="l-mockup-nav-icon">📅</span> Calendar
              </div>
              <div class="l-mockup-nav-item">
                <span class="l-mockup-nav-icon">🌐</span> Bookings
              </div>
              <div class="l-mockup-nav-item">
                <span class="l-mockup-nav-icon">📊</span> Analytics
              </div>
            </div>
            <%# Main %>
            <div class="l-mockup-main">
              <div class="l-mockup-title">Dashboard</div>
              <div class="l-mockup-stats">
                <div class="l-mockup-stat">
                  <div class="l-mockup-stat-label">Doctors</div>
                  <div class="l-mockup-stat-val teal">4</div>
                </div>
                <div class="l-mockup-stat">
                  <div class="l-mockup-stat-label">Patients</div>
                  <div class="l-mockup-stat-val">128</div>
                </div>
                <div class="l-mockup-stat">
                  <div class="l-mockup-stat-label">Appointments</div>
                  <div class="l-mockup-stat-val">312</div>
                </div>
                <div class="l-mockup-stat">
                  <div class="l-mockup-stat-label">Today</div>
                  <div class="l-mockup-stat-val amber">7</div>
                </div>
              </div>
              <div class="l-mockup-table-title">Recent Appointments</div>
              <div class="l-mockup-row">
                <div class="l-mockup-avatar">SB</div>
                <div class="l-mockup-row-info">
                  <div class="l-mockup-row-name">Sara Benali</div>
                  <div class="l-mockup-row-sub">Dr. Karim — 09:30</div>
                </div>
                <div class="l-mockup-badge confirmed">Confirmed</div>
              </div>
              <div class="l-mockup-row">
                <div class="l-mockup-avatar">JM</div>
                <div class="l-mockup-row-info">
                  <div class="l-mockup-row-name">Jacques Martin</div>
                  <div class="l-mockup-row-sub">Dr. Leila — 11:00</div>
                </div>
                <div class="l-mockup-badge pending">Pending</div>
              </div>
              <div class="l-mockup-row">
                <div class="l-mockup-avatar">AH</div>
                <div class="l-mockup-row-info">
                  <div class="l-mockup-row-name">Amina Hassan</div>
                  <div class="l-mockup-row-sub">Dr. Karim — 14:00</div>
                </div>
                <div class="l-mockup-badge online">🌐 Online</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

