<%# ═══════════════════════════════════════════
    PRICING
═══════════════════════════════════════════ %>
<section class="l-section l-section-alt" id="pricing">
  <div class="lc">
    <div class="l-section-header center">
      <div class="l-eyebrow"><%= t("landing.nav.pricing") %></div>
      <h2 class="l-section-title"><%= t("landing.pricing.title") %></h2>
      <p class="l-section-sub"><%= t("landing.pricing.subtitle") %></p>
    </div>

    <div class="l-pricing-grid">

      <%# ── Starter ── %>
      <div class="l-plan-card">
        <div class="l-plan-icon starter"><i class="bi bi-lightning-charge-fill"></i></div>
        <div class="l-plan-name"><%= t("landing.pricing.starter_name") %></div>
        <div class="l-plan-price">
          <span class="l-plan-price-val">€<%= t("landing.pricing.starter_price") %></span>
          <span class="l-plan-price-mo"><%= t("landing.pricing.per_month") %></span>
        </div>
        <p class="l-plan-desc"><%= t("landing.pricing.starter_desc") %></p>
        <ul class="l-plan-features">
          <li><%= t("landing.pricing.starter_f1") %></li>
          <li><%= t("landing.pricing.starter_f2") %></li>
          <li><%= t("landing.pricing.starter_f3") %></li>
          <li><%= t("landing.pricing.starter_f4") %></li>
          <li><%= t("landing.pricing.starter_f5") %></li>
          <li><%= t("landing.pricing.starter_f6") %></li>
        </ul>
        <%= link_to t("landing.pricing.cta"), new_user_registration_path,
              class: "l-btn l-btn-md l-btn-outline w-100 justify-content-center" %>
        <p class="l-plan-trial"><%= t("landing.pricing.trial_note") %></p>
      </div>

      <%# ── Pro ── %>
      <div class="l-plan-card popular">
        <div class="l-plan-popular-badge"><%= t("landing.pricing.badge_popular") %></div>
        <div class="l-plan-icon pro"><i class="bi bi-star-fill"></i></div>
        <div class="l-plan-name"><%= t("landing.pricing.pro_name") %></div>
        <div class="l-plan-price">
          <span class="l-plan-price-val">€<%= t("landing.pricing.pro_price") %></span>
          <span class="l-plan-price-mo"><%= t("landing.pricing.per_month") %></span>
        </div>
        <p class="l-plan-desc"><%= t("landing.pricing.pro_desc") %></p>
        <ul class="l-plan-features">
          <li><%= t("landing.pricing.pro_f1") %></li>
          <li><%= t("landing.pricing.pro_f2") %></li>
          <li><%= t("landing.pricing.pro_f3") %></li>
          <li><%= t("landing.pricing.pro_f4") %></li>
          <li><%= t("landing.pricing.pro_f5") %></li>
          <li><%= t("landing.pricing.pro_f6") %></li>
        </ul>
        <%= link_to t("landing.pricing.cta"), new_user_registration_path,
              class: "l-btn l-btn-md l-btn-primary w-100 justify-content-center" %>
        <p class="l-plan-trial"><%= t("landing.pricing.trial_note") %></p>
      </div>

      <%# ── Clinic+ ── %>
      <div class="l-plan-card">
        <div class="l-plan-icon clinic"><i class="bi bi-gem"></i></div>
        <div class="l-plan-name"><%= t("landing.pricing.enterprise_name") %></div>
        <div class="l-plan-price">
          <span class="l-plan-price-val">€<%= t("landing.pricing.enterprise_price") %></span>
          <span class="l-plan-price-mo"><%= t("landing.pricing.per_month") %></span>
        </div>
        <p class="l-plan-desc"><%= t("landing.pricing.enterprise_desc") %></p>
        <ul class="l-plan-features">
          <li><%= t("landing.pricing.enterprise_f1") %></li>
          <li><%= t("landing.pricing.enterprise_f2") %></li>
          <li><%= t("landing.pricing.enterprise_f3") %></li>
          <li><%= t("landing.pricing.enterprise_f4") %></li>
          <li><%= t("landing.pricing.enterprise_f5") %></li>
          <li><%= t("landing.pricing.enterprise_f6") %></li>
        </ul>
        <%= link_to t("landing.pricing.cta"), new_user_registration_path,
              class: "l-btn l-btn-md l-btn-outline w-100 justify-content-center" %>
        <p class="l-plan-trial"><%= t("landing.pricing.trial_note") %></p>
      </div>

    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════
    FAQ
═══════════════════════════════════════════ %>
<section class="l-section" id="faq">
  <div class="lc">
    <div class="l-section-header center">
      <div class="l-eyebrow">FAQ</div>
      <h2 class="l-section-title"><%= t("landing.faq.title") %></h2>
    </div>

    <div class="l-faq-list">
      <% 6.times do |i| %>
        <% n = i + 1 %>
        <div class="l-faq-item">
          <button class="l-faq-btn" type="button">
            <%= t("landing.faq.q#{n}") %>
            <span class="l-faq-arrow"><i class="bi bi-plus"></i></span>
          </button>
          <div class="l-faq-body">
            <%= t("landing.faq.a#{n}") %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════
    FINAL CTA
═══════════════════════════════════════════ %>
<section class="l-cta-section">
  <div class="lc l-cta-inner">
    <h2 class="l-cta-title"><%= t("landing.cta.title") %></h2>
    <p class="l-cta-sub"><%= t("landing.cta.subtitle") %></p>
    <%= link_to t("landing.cta.button"), new_user_registration_path,
          class: "l-btn l-btn-lg",
          style: "background:white;color:#0d9488;font-weight:800;box-shadow:0 8px 28px rgba(0,0,0,.25);" %>
    <p class="l-cta-note"><%= t("landing.cta.note") %></p>
  </div>
</section>
